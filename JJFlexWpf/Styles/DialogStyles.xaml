<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JJFlexWpf">

    <!-- Standard dialog button style -->
    <Style x:Key="DialogButton" TargetType="Button">
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="12,4"/>
    </Style>

    <!-- OK button (inherits DialogButton, adds IsDefault) -->
    <Style x:Key="OkButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
        <Setter Property="IsDefault" Value="True"/>
    </Style>

    <!-- Cancel button (inherits DialogButton, adds IsCancel) -->
    <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
        <Setter Property="IsCancel" Value="True"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- Standard label in dialogs -->
    <Style x:Key="DialogLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- Standard text input in dialogs -->
    <Style x:Key="DialogTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- Standard combo box in dialogs -->
    <Style x:Key="DialogComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- Group box header -->
    <Style x:Key="DialogGroupBox" TargetType="GroupBox">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- Standard button panel (OK/Cancel row at bottom) -->
    <Style x:Key="ButtonPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <!-- ── Category navigation (Sprint 32 Track G, task #134) ──────────────

         A dialog with a dozen sections gets a CATEGORY LIST rather than a tab
         strip, the shape NVDA's own settings dialog uses: a list down the left
         naming every section, the section itself filling the rest, and
         Ctrl+Tab / Ctrl+Shift+Tab stepping between them from anywhere inside.
         CategoryNavigator.Attach does the wiring; these two styles are the
         look.

         The TabControl STAYS as the container — only its header strip goes
         away. That is deliberate and load-bearing: sections are still authored
         as plain TabItems, so adding one is still one XAML block and needs no
         knowledge of any of this. The category list enumerates whatever
         TabItems exist rather than naming them.

         Why the strip goes rather than sitting alongside the list: two
         controls selecting the same thing is two tab stops, two places to
         land, and two announcements for one act. The strip also arrows —
         Left and Right on a focused strip change section — which is a second
         way to move that nothing tells you about.

         The style targets CategoryTabHost, NOT TabControl, and that is
         load-bearing (2026-08-20 merge regression). A stock TabControl's
         automation peer enumerates its children through the items host this
         template deletes — it does not degrade, it THROWS, truncating the
         window's UIA tree at this control. Every control in every category
         was reachable by Tab yet absent from what a screen reader could see:
         real tab stops, total silence. CategoryTabHost swaps in a plain
         visual-walk peer that exposes the selected content as a pane. Keeping
         the TargetType on the subclass makes the broken pairing — headerless
         template on a stock TabControl peer — unconstructible.
    -->
    <Style x:Key="CategoryTabControl" TargetType="local:CategoryTabHost">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CategoryTabHost">
                    <!-- Selected content only. No TabPanel, so there is no
                         header strip to focus, to arrow through, or to leave a
                         Tab-only operator wondering what just changed. -->
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      ContentSource="SelectedContent"
                                      Margin="{TemplateBinding Padding}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CategoryList" TargetType="ListBox">
        <Setter Property="Width" Value="170"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

</ResourceDictionary>
