<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>JJFlexWpf</RootNamespace>
    <AssemblyName>JJFlexWpf</AssemblyName>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.3.0</Version>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" />
    <PackageReference Include="FftSharp" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Sounds\click.wav" LogicalName="JJFlexWpf.Sounds.click.wav" />
    <EmbeddedResource Include="Resources\Sounds\confirm.wav" LogicalName="JJFlexWpf.Sounds.confirm.wav" />
    <EmbeddedResource Include="Resources\Sounds\filter-edge-move.wav" LogicalName="JJFlexWpf.Sounds.filter-edge-move.wav" />
    <EmbeddedResource Include="Resources\Sounds\mode-enter.wav" LogicalName="JJFlexWpf.Sounds.mode-enter.wav" />
    <EmbeddedResource Include="Resources\Sounds\mode-exit.wav" LogicalName="JJFlexWpf.Sounds.mode-exit.wav" />
    <EmbeddedResource Include="Resources\Sounds\slide03.wav" LogicalName="JJFlexWpf.Sounds.slide03.wav" />
    <EmbeddedResource Include="Resources\Sounds\zip01.wav" LogicalName="JJFlexWpf.Sounds.zip01.wav" />
    <EmbeddedResource Include="Resources\AboutGeneral.html" LogicalName="JJFlexWpf.Resources.AboutGeneral.html" />
    <EmbeddedResource Include="Resources\AboutRadio.html" LogicalName="JJFlexWpf.Resources.AboutRadio.html" />
    <EmbeddedResource Include="Resources\AboutSystem.html" LogicalName="JJFlexWpf.Resources.AboutSystem.html" />
    <EmbeddedResource Include="Resources\AboutDiagnostics.html" LogicalName="JJFlexWpf.Resources.AboutDiagnostics.html" />
    <!-- Per-model panel references. Embedded straight from the help source tree so
         the CHM build and RadioPanelGuide read the same file — no second copy. -->
    <EmbeddedResource Include="..\docs\help\md\know-your-radio-6300.md" LogicalName="JJFlexWpf.Help.know-your-radio-6300.md" />
    <EmbeddedResource Include="..\docs\help\md\know-your-radio-6400-6600.md" LogicalName="JJFlexWpf.Help.know-your-radio-6400-6600.md" />
    <EmbeddedResource Include="..\docs\help\md\know-your-radio-6500.md" LogicalName="JJFlexWpf.Help.know-your-radio-6500.md" />
    <EmbeddedResource Include="..\docs\help\md\know-your-radio-6700.md" LogicalName="JJFlexWpf.Help.know-your-radio-6700.md" />
    <EmbeddedResource Include="..\docs\help\md\know-your-radio-8400-8600.md" LogicalName="JJFlexWpf.Help.know-your-radio-8400-8600.md" />
    <!-- Calibration assets (hashed names by design) -->
    <Content Include="Resources\4f89f8bc7\4c85663.f6cdb1f" CopyToOutputDirectory="PreserveNewest" Link="Resources\4f89f8bc7\4c85663.f6cdb1f" />
    <Content Include="Resources\4f89f8bc7\8abf5a4.0d3a3f5" CopyToOutputDirectory="PreserveNewest" Link="Resources\4f89f8bc7\8abf5a4.0d3a3f5" />
    <Content Include="Resources\4f89f8bc7\d7d8480.7605032" CopyToOutputDirectory="PreserveNewest" Link="Resources\4f89f8bc7\d7d8480.7605032" />
    <Content Include="Resources\4f89f8bc7\8b38e27\*" CopyToOutputDirectory="PreserveNewest" Link="Resources\4f89f8bc7\8b38e27\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlexLib_API\UiWpfFramework\UiWpfFramework.csproj" />
    <ProjectReference Include="..\Radios\Radios.csproj" />
    <ProjectReference Include="..\HamQTHLookup\HamQTHLookup.csproj" />
    <ProjectReference Include="..\QrzLookup\QrzLookup.csproj" />
    <ProjectReference Include="..\JJCountriesDB\JJCountriesDB.csproj" />
    <ProjectReference Include="..\JJTrace\JJTrace.csproj" />
    <ProjectReference Include="..\JJFlexUpdater\JJFlexUpdater.csproj" />
    <!-- QB Track B: the Audio Devices dialog enumerates and persists the
         PortAudio devices that carry radio audio to and from this computer.
         Referenced directly rather than relied on transitively through Radios,
         so the dependency is visible where it is used. -->
    <ProjectReference Include="..\JJPortaudio\JJPortaudio\JJPortaudio.csproj" />
  </ItemGroup>
</Project>
