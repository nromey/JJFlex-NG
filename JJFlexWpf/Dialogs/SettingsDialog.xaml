<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:JJFlexWpf"
    xmlns:controls="clr-namespace:JJFlexWpf.Controls"
    Title="Settings"
    Width="660" Height="560"
    ResizeMode="NoResize">
    <!-- Wider than it was (460) because the category list now takes the
         left-hand 170 (Sprint 32 Track G, task #134). The settings themselves
         ended up with slightly MORE room than before, not less. -->
    <DockPanel Margin="12">
        <!-- Buttons at bottom. The house convention (Track C, 2026-08-16):
             OK applies and closes, Apply applies and stays, Cancel discards —
             the same pair on every settings screen, no per-feature variants.
             Apply stays present and enabled even when nothing has changed:
             disabling it would drop it from the tab order (house rule keeps
             disabled controls out), and a button that vanishes mid-dialog is
             worse than a no-op for anyone counting tab stops.

             Declared first so it docks across the FULL width, under both the
             category list and the settings — the layout everyone expects. Tab
             order is set explicitly below rather than inherited from
             declaration order, because the two no longer want to agree. -->
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ButtonPanel}"
                    KeyboardNavigation.TabIndex="3">
            <Button Content="_OK" AutomationProperties.AcceleratorKey="Alt+O" Style="{StaticResource OkButton}"
                    AutomationProperties.Name="OK"
                    Click="OkButton_Click"/>
            <Button Content="_Apply" AutomationProperties.AcceleratorKey="Alt+A" Style="{StaticResource DialogButton}"
                    AutomationProperties.Name="Apply"
                    Click="ApplyButton_Click"/>
            <Button Content="_Cancel" AutomationProperties.AcceleratorKey="Alt+C" Style="{StaticResource CancelButton}"
                    AutomationProperties.Name="Cancel"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- The category list (task #134). Contents are built by
             CategoryNavigator from whatever TabItems exist below — never
             listed here, so adding a settings category stays a one-block XAML
             edit and this list picks it up.

             TabIndex 1: the dialog opens ON this list. Eleven categories deep,
             the first thing an operator should hear is where they are and what
             else there is, not the first field of whichever category happens
             to be showing. Ctrl+Tab and Ctrl+Shift+Tab reach it from anywhere
             inside the dialog. -->
        <ListBox x:Name="CategoryListBox"
                 DockPanel.Dock="Left"
                 Style="{StaticResource CategoryList}"
                 TabIndex="1"
                 AutomationProperties.Name="Settings categories"
                 local:JJFlexHelp.Text="Every group of settings, in one list. Arrow through it to move between them, or use Control plus Tab and Control plus Shift plus Tab from anywhere in this dialog. Tab moves from here into the settings themselves."/>

        <!-- The categories. Styled headerless: the list above IS the tab
             strip now. -->
        <TabControl x:Name="SettingsTabs"
                    Style="{StaticResource CategoryTabControl}"
                    KeyboardNavigation.TabIndex="2"
                    AutomationProperties.Name="Settings categories">
            <!-- PTT Tab -->
            <TabItem Header="PTT" AutomationProperties.Name="Push to talk settings">
                <StackPanel Margin="8">
                    <!-- Field labels ending in ":" are controls:DecorativeText, not TextBlock.

     Every one of them sits above a control that carries its own, fuller
     AutomationProperties.Name - "Speed (WPM):" labels a box named "CW
     notification speed, 10 to 60 words per minute". A screen reader reads
     static text as dialog BODY when the dialog opens, so each label was heard
     once on open and again on focus, and the on-open copy is the less useful
     of the two.

     DecorativeText keeps them on screen for a sighted operator and removes them
     from the UIA tree. Verified before changing: all 27 had a named control, and
     NONE were the only identification for their field. A label whose control has
     no Name must stay a plain TextBlock - it is the only thing naming that
     field. Checked 2026-08-18.

     Section headings ("Meter Tones", "Braille Display") are deliberately NOT
     decorated: they name a GROUP, and nothing else conveys that grouping. -->
<Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <controls:DecorativeText Grid.Row="0" Grid.Column="0"
                                   Text="Timeout (seconds):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PttTimeoutBox" Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="PTT timeout in seconds, 10 to 900"/>

                        <controls:DecorativeText Grid.Row="1" Grid.Column="0"
                                   Text="First warning (seconds before timeout):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PttWarning1Box" Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="First warning, seconds before timeout"/>

                        <controls:DecorativeText Grid.Row="2" Grid.Column="0"
                                   Text="Second warning (seconds before timeout):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PttWarning2Box" Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="Second warning, seconds before timeout"/>

                        <controls:DecorativeText Grid.Row="3" Grid.Column="0"
                                   Text="Final warning (seconds before timeout):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PttOhCrapBox" Grid.Row="3" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="Final warning, seconds before timeout"/>

                        <controls:DecorativeText Grid.Row="4" Grid.Column="0"
                                   Text="ALC auto-release (seconds, 0=off):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PttAlcBox" Grid.Row="4" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="ALC auto-release seconds, 0 to disable or 10 to 300"/>
                    </Grid>

                    <CheckBox x:Name="PttSpeechCheckbox"
                              Content="Announce transmit and receive state changes"
                              Margin="0,12,0,0"
                              AutomationProperties.Name="Announce transmit and receive state changes"/>

                    <CheckBox x:Name="ChirpEnabledCheckbox"
                              Content="Play chirp tones on transmit and receive"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Play chirp tones on transmit and receive"/>
                </StackPanel>
            </TabItem>

            <!-- Tuning Tab -->
            <TabItem Header="Tuning" AutomationProperties.Name="Tuning settings">
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <controls:DecorativeText Grid.Row="0" Grid.Column="0"
                                   Text="Coarse step default:"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <ComboBox x:Name="CoarseStepCombo" Grid.Row="0" Grid.Column="1"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Default coarse tuning step"/>

                        <controls:DecorativeText Grid.Row="1" Grid.Column="0"
                                   Text="Fine step default:"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <ComboBox x:Name="FineStepCombo" Grid.Row="1" Grid.Column="1"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Default fine tuning step"/>
                    </Grid>

                    <CheckBox x:Name="BandMemoryCheckbox"
                              Content="Enable band memory"
                              IsChecked="True" Margin="0,12,0,0"
                              AutomationProperties.Name="Enable band memory"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <controls:DecorativeText Text="Frequency speech units:" VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="FreqUnitsCombo" Width="120"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Frequency speech units"/>
                    </StackPanel>

                    <Separator Margin="0,8,0,8"/>

                    <Button Content="Edit _Filter Presets..."
                            Width="160" HorizontalAlignment="Left"
                            AutomationProperties.Name="Edit filter presets"
                            AutomationProperties.AcceleratorKey="Alt+F"
                            Click="EditFilterPresetsButton_Click"/>

                    <Separator Margin="0,8,0,8"/>

                    <CheckBox x:Name="TuneDebounceCheckbox"
                              Content="Debounce tuning speech (group rapid steps)"
                              Margin="0,12,0,0"
                              AutomationProperties.Name="Debounce tuning speech"
                   local:JJFlexHelp.Text="groups rapid tuning steps into one announcement"
                              Checked="TuneDebounceCheckbox_Changed"
                              Unchecked="TuneDebounceCheckbox_Changed"/>

                    <StackPanel x:Name="DebounceDelayPanel" Orientation="Horizontal" Margin="20,8,0,0">
                        <controls:DecorativeText Text="Debounce delay (ms):" VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="DebounceDelayBox" Width="60"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="Debounce delay in milliseconds, 50 to 1000"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- License Tab -->
            <TabItem Header="License" AutomationProperties.Name="License settings">
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <controls:DecorativeText Grid.Row="0" Grid.Column="0"
                                   Text="License class:"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <ComboBox x:Name="LicenseClassCombo" Grid.Row="0" Grid.Column="1"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="FCC license class"/>
                    </Grid>

                    <CheckBox x:Name="BandBoundaryCheckbox"
                              Content="Band boundary notifications"
                              Margin="0,12,0,0"
                              AutomationProperties.Name="Notify when tuning near band boundaries"/>
                    <CheckBox x:Name="TxLockoutCheckbox"
                              Content="TX band lockout"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Prevent transmitting outside licensed bands"/>

                    <Separator Margin="0,12,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <controls:DecorativeText Text="Country:" VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CountryCombo" Width="120"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Country for 60 meter channelization rules"/>
                    </StackPanel>

                    <CheckBox x:Name="EnforceTxRulesCheckbox"
                              Content="Enforce transmit rules (60m channels, power limits)"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Enforce transmit parameters based on published amateur radio rules"/>
                </StackPanel>
            </TabItem>

            <!-- Audio Tab (merged: alerts, meters, master volume) -->
            <TabItem Header="Audio" AutomationProperties.Name="Audio settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <!-- Master Volume -->
                    <controls:ValueFieldControl x:Name="MasterVolumeControl"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="Master volume, 0 to 100, scales all audio"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- ============================================================
                         Radio Outputs — the radio's own physical outputs.

                         High on the page because on a radio with no front panel
                         these are the ONLY volume controls that exist. There is
                         no knob to reach for; if they are wrong the radio is
                         simply silent and nothing says why.

                         The controls appear only with a radio connected: they
                         read and write live radio state, and a disabled control
                         that never explains itself is worse than a sentence that
                         says why it is not there.
                         ============================================================ -->
                    <TextBlock Text="Radio Outputs" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>

                    <TextBlock x:Name="RadioOutputsAdvisory"
                               Style="{StaticResource DialogLabel}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"
                               Focusable="True"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Radio audio status"/>

                    <StackPanel x:Name="RadioOutputsPanel" Visibility="Collapsed">
                        <controls:ValueFieldControl x:Name="HeadphoneLevelControl"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Headphone level, 0 to 100, sent to the radio as you change it"/>
                        <controls:ValueFieldControl x:Name="LineOutLevelControl"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Line out level, 0 to 100, sent to the radio as you change it"/>
                        <CheckBox x:Name="HeadphoneMuteCheck"
                                  Content="Mute the headphone output"
                                  Margin="0,0,0,4"
                                  AutomationProperties.Name="Mute the radio's headphone output"
                                  Click="RadioOutputMute_Click"/>
                        <CheckBox x:Name="LineOutMuteCheck"
                                  Content="Mute the line out output"
                                  Margin="0,0,0,4"
                                  AutomationProperties.Name="Mute the radio's line out output"
                                  Click="RadioOutputMute_Click"/>
                        <CheckBox x:Name="FrontSpeakerMuteCheck"
                                  Content="Mute the front panel speaker"
                                  Margin="0,0,0,8"
                                  AutomationProperties.Name="Mute the radio's front panel speaker"
                                  Click="RadioOutputMute_Click"/>
                    </StackPanel>

                    <Button x:Name="WhySilentButton"
                            Content="Why is my radio _silent?"
                            HorizontalAlignment="Left" Padding="12,4"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Why is my radio silent, check the most likely causes"
                            AutomationProperties.AcceleratorKey="Alt+S"
                            Click="WhySilentButton_Click"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- ============================================================
                         Radio audio through this computer (PC audio).

                         The checkbox reflects and overrides the CURRENT session.
                         What happens at the NEXT connect is the per-radio combo
                         below it (Threads Track, 2026-08-12): remember-last by
                         default, with explicit always-on / always-off because
                         remember-last faithfully carries an accident forward.
                         The old "quietly fight the remote auto-on" trap this
                         section used to warn about is closed by announcing the
                         applied state out loud on every connect.
                         ============================================================ -->
                    <TextBlock Text="Radio Audio Through This Computer" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="PcAudioCheck"
                              Content="Play radio audio through this computer"
                              Margin="0,0,0,4"
                              AutomationProperties.Name="Play radio audio through this computer"
                   local:JJFlexHelp.Text="and send this computer's microphone to the radio"
                              Click="PcAudioCheck_Click"/>
                    <TextBlock x:Name="PcAudioStatusText"
                               Style="{StaticResource DialogLabel}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Focusable="True"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Radio audio through this computer, status"/>
                    <!-- Per-radio on-connect behaviour. Collapsed (out of the
                         tab order, house rule) when no radio is connected —
                         the setting is keyed by the radio's serial. Saves as
                         it changes, like its live neighbors above. -->
                    <StackPanel x:Name="PcAudioOnConnectPanel" Visibility="Collapsed">
                        <TextBlock Text="When this radio connects"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="PcAudioOnConnectCombo"
                                  HorizontalAlignment="Left" MinWidth="320"
                                  Margin="0,0,0,8"
                                  AutomationProperties.Name="PC audio when this radio connects, saved for this radio"
                                  SelectionChanged="PcAudioOnConnectCombo_SelectionChanged">
                            <ComboBoxItem Content="As I left it"/>
                            <ComboBoxItem Content="Always on for this radio"/>
                            <ComboBoxItem Content="Always off for this radio"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- PC output volume (Audio Arc Track A) — the playback
                         boost for radio audio through this computer, in dB.
                         App-level and persisted, unlike the PC audio on/off
                         above; applies live like the radio output levels. -->
                    <controls:ValueFieldControl x:Name="PcOutputVolumeControl"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="PC output volume in dB"
                   local:JJFlexHelp.Text="how loud radio audio plays through this computer, applied as you change it"/>
                    <Button x:Name="AudioDevicesButton"
                            Content="Audio _Devices..."
                            HorizontalAlignment="Left" Padding="12,4"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Audio Devices, choose which sound devices JJ Flex uses"
                            AutomationProperties.AcceleratorKey="Alt+D"
                            Click="AudioDevicesButton_Click"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Alert section. The CW notification settings live here
                         rather than on Notifications, because CW notifications
                         play through the alert device — the device and the
                         switch that uses it should read as one thing. -->
                    <TextBlock Text="Alerts and CW Notifications" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <controls:ValueFieldControl x:Name="EarconVolumeControl"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="Alert volume, 0 to 100"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:DecorativeText Text="Alert device:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="EarconDeviceCombo" Width="200"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Alert audio output device, also used for CW notifications"/>
                    </StackPanel>
                    <CheckBox x:Name="CwNotificationsCheck"
                              Content="Enable CW notifications (AS, BT, SK prosigns)"
                              Margin="0,0,0,4"
                              AutomationProperties.Name="Enable Morse code notifications for connection events"
                   local:JJFlexHelp.Text="played through the alert device"/>
                    <Grid Margin="20,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:DecorativeText Grid.Row="0" Grid.Column="0"
                                   Text="Sidetone frequency (Hz):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="CwSidetoneBox" Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="CW sidetone frequency, 400 to 1200 hertz"/>
                        <controls:DecorativeText Grid.Row="1" Grid.Column="0"
                                   Text="Speed (WPM):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="CwSpeedBox" Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="CW notification speed, 10 to 60 words per minute"/>
                    </Grid>
                    <CheckBox x:Name="CwModeAnnounceCheck"
                              Content="Use CW to announce mode changes"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Use CW to announce mode changes"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Meter section -->
                    <TextBlock Text="Meter Tones" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <controls:ValueFieldControl x:Name="MeterVolumeControl"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="Meter tone volume, 0 to 100"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:DecorativeText Text="Meter device:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="MeterDeviceCombo" Width="200"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Meter tone audio output device"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:DecorativeText Text="Preset:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="MeterPresetCombo" Width="150"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Meter tone preset"/>
                    </StackPanel>
                    <CheckBox x:Name="PeakWatcherCheck"
                              Content="Peak Watcher ALC alerts"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable Peak Watcher ALC alerts"/>
                    <CheckBox x:Name="MeterSpeechCheck"
                              Content="Meter speech readout"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable meter speech readout"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Typing sound -->
                    <TextBlock Text="Frequency Entry" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:DecorativeText Text="Typing sound:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TypingSoundCombo" Width="180"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Frequency entry typing sound mode"/>
                    </StackPanel>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Braille Display section -->
                    <TextBlock Text="Braille Display" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="BrailleEnabledCheck"
                              Content="Enable braille status line"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable braille status line on home position"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:DecorativeText Text="Display cells:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="BrailleCellsCombo" Width="80"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Braille display cell count"/>
                    </StackPanel>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Audio Workshop shortcut -->
                    <Button Content="Audio _Workshop..."
                            Width="160" HorizontalAlignment="Left"
                            AutomationProperties.Name="Audio Workshop"
                            AutomationProperties.AcceleratorKey="Alt+W"
                            Click="AudioWorkshopButton_Click"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Network Tab (SmartLink port forwarding) -->
            <TabItem Header="Network" AutomationProperties.Name="Network and SmartLink settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="SmartLink Port Forwarding (Tier 1)" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <!-- Track C: this text used to claim the radio listens on the
                         port you type. It does not — the typed port is the
                         EXTERNAL port your router shows the internet; the radio
                         always listens on its LAN address at TCP 4994 and UDP
                         4993. The old wording misled a live debugging session
                         (2026-08-14). -->
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Tell the radio which external port to advertise for SmartLink. The port you choose here is the one the internet sees — the radio itself always listens on its LAN address at TCP port 4994 and UDP port 4993. Your router needs two rules: forward your chosen external TCP port to the radio's LAN IP at port 4994, and your chosen external UDP port to the radio's LAN IP at port 4993. Changing this requires an active radio connection; press Apply or OK to send it."/>

                    <!-- Sprint 27 Track A: Tier 1 framing prose. Explains what this mode means and why it's the recommended default. -->
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Tier 1 (Manual Port Forwarding) is the recommended default. You choose the external port and set the two router rules yourself, and JJ Flex tells the radio to advertise that port. Tier 1 is sovereign — there is no third-party coordination, no UPnP, and no hole-punch. It is the only tier compatible with organizational security policies that require UPnP disabled (DISA STIGs, PCI-DSS, HIPAA), and it is the most reliable path through strict NAT configurations. Your chosen port is saved with your SmartLink account; on future connections, JJ Flex applies it automatically."/>

                    <TextBlock x:Name="NetworkCurrentStateText"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,8"
                               AutomationProperties.LiveSetting="Polite"/>

                    <CheckBox x:Name="PortForwardEnabledCheck"
                              Content="Enable manual port forwarding"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable manual port forwarding on the radio"
                              Click="PortForwardEnabledCheck_Click"/>

                    <Grid Margin="20,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:DecorativeText Grid.Row="0" Grid.Column="0"
                                   Text="Port (TCP and UDP):"
                                   x:Name="PortForwardTcpLabel"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PortForwardTcpBox" Grid.Row="0" Grid.Column="1"
                                 Text="4992"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="Port number, 1024 to 65535, applied to TCP and UDP"
                                 TextChanged="PortForwardTcpBox_TextChanged"/>
                        <controls:DecorativeText Grid.Row="1" Grid.Column="0"
                                   Text="UDP port:"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PortForwardUdpBox" Grid.Row="1" Grid.Column="1"
                                 Text="4992" IsEnabled="False"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="UDP port number, 1024 to 65535"/>
                    </Grid>

                    <CheckBox x:Name="PortForwardSeparatePortsCheck"
                              Content="Use different TCP and UDP ports (advanced)"
                              Margin="20,0,0,8"
                              AutomationProperties.Name="Allow different TCP and UDP ports"
                              Checked="PortForwardSeparatePortsCheck_Changed"
                              Unchecked="PortForwardSeparatePortsCheck_Changed"/>

                    <!-- Track C: the per-feature "Apply to connected radio" button is
                         gone — the dialog's own Apply and OK commit these edits now,
                         the same as every other setting, so an edit here can no
                         longer be silently discarded by OK. Test performs local
                         validation only (range + common-conflict blocklist) without
                         touching the radio or persisting. -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Te_st port"
                                Width="120"
                                AutomationProperties.Name="Test the port number locally for validity and common conflicts"
                                AutomationProperties.AcceleratorKey="Alt+S"
                                Click="TestPortButton_Click"/>
                    </StackPanel>

                    <!-- Sprint 27 Track F: Connection mode three-option radio group. Replaces B.2's single UPnP checkbox. Three cumulative tiers: manual-only (Tier 1), manual + UPnP (Tier 1+2), manual + UPnP + hole-punch (Tier 1+2+3). Tier 2 and Tier 3 options are gated on a valid Tier 1 port being configured. -->
                    <Separator Margin="0,16,0,8"/>
                    <GroupBox Header="Connection mode" Margin="0,0,0,8"
                              AutomationProperties.Name="SmartLink connection mode">
                        <StackPanel Margin="4">
                            <!-- QB Track C: the tier gate needs its reason on the
                                 surface (Feature Availability pattern) — a screen
                                 reader user landing on a disabled Tier 3 with no
                                 explanation, while owning a radio that can ONLY
                                 hole punch, was the lived chicken-and-egg. The
                                 per-radio path is the honest answer for that radio
                                 and this text is the signpost to it. -->
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="This ladder is your account-wide default, and tiers 2 and 3 unlock only after manual port forwarding above is enabled with a valid port, because they build on it. It cannot describe a radio that has no port forwarding at all. For that — or for any radio that should always hole punch — use the Radios tab: the per-radio setting there outranks this ladder, needs no port-forward setup, and works without a connected radio."/>
                            <RadioButton x:Name="Tier1Radio"
                                         GroupName="ConnectionMode"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Tier 1, manual port forwarding only. Sovereign default."
                                         Checked="ConnectionModeRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="Tier 1 — Manual port forwarding only (recommended default)" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="You forward the port configured above on your router. No UPnP, no hole-punch. The only mode compatible with strict security policies (DISA STIGs, PCI-DSS, HIPAA) and the most reliable path through picky NATs."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Tier2Radio"
                                         GroupName="ConnectionMode"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Tier 1 plus 2, manual plus UPnP automatic port mapping"
                                         Checked="ConnectionModeRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="Tier 1 + 2 — Manual + UPnP" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="The radio asks your router via UPnP to open the port automatically. JJ Flex does not do this itself and cannot turn UPnP on — if your router has UPnP switched off, that is a change on the router, not here. UPnP is also convenient in a way worth knowing about: it lets any program on your network open a way in without asking, which is why many routers and most workplace networks disable it. If UPnP does not work, JJ Flex falls back to Tier 1."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Tier3Radio"
                                         GroupName="ConnectionMode"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Tier 1 plus 2 plus 3"
                   local:JJFlexHelp.Text="allow automatic hole punch for restrictive networks"
                                         Checked="ConnectionModeRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="Tier 1 + 2 + 3 — Allow automatic hole-punch" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="If direct port forwarding or UPnP is not working, let Flex's SmartLink coordinate a UDP hole-punch between the radio and JJ Flex. Works through most home NATs. May fail on symmetric-NAT networks (some corporate environments and mobile-carrier networks). Fallback to Tier 2 then Tier 1 on failure is automatic."/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>

                    <!-- Legacy checkbox kept hidden for backward binding during the F.0/F.1 transition. The radio group above is the canonical UI. Will be removed in F.3 rollup cleanup if still present. -->
                    <CheckBox x:Name="UPnPEnabledCheck" Visibility="Collapsed" IsEnabled="False"/>

                    <!-- QB Track C untangling: the account-level ConfiguredListenPort
                         used to carry TWO meanings — the radio-side forwarded port
                         (written by Apply above) AND the client-side hole-punch port
                         (written by a box that lived here) — one slot, disambiguated
                         only by connection mode. The punch meaning now lives in the
                         per-radio profile (Radios tab, FixedHolePunchPort), which is
                         where it belongs: the punch port is a property of reaching a
                         particular radio's site, not of the operator's account. The
                         account field keeps only the forwarded-port meaning. A punch
                         port saved by an older build is still honored as a legacy
                         fallback until the radio has its own profile setting. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Hole-punch Port" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="The hole-punch port is a per-radio setting — it belongs to the radio's site, not your account. Set it on the Radios tab, which works whether or not a radio is connected. Leaving it blank there is recommended: JJ Flex then picks a fresh port for every connection, which avoids clashing with a leftover mapping in the router. A port saved here by an earlier version of JJ Flex is still honored until the radio has its own setting."/>

                    <!-- What the radio and SmartLink actually report, as opposed to
                         what has been configured. The two differ constantly, and the
                         difference is the whole story when a connection will not
                         come up. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="What the Radio Reports" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Live facts from the radio and from SmartLink, rather than what is configured above. When a connection will not come up, the gap between the two is usually the answer."/>
                    <TextBlock x:Name="ReachabilityStatusText"
                               Style="{StaticResource DialogLabel}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="What the radio reports about its reachability"/>
                    <Button Content="Refresh what the radio reports"
                            HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,8"
                            AutomationProperties.Name="Re-read the radio's reachability status"
                            Click="RefreshReachabilityButton_Click"/>

                    <!-- Private-IP enforcement. Surfaced because Tailscale hands out
                         CGNAT addresses (100.64.x.x), which are not private addresses
                         in the sense the radio means — with this on, a tailnet client
                         gets refused with no useful explanation. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Who May Connect" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="EnforcePrivateIpCheck"
                              Content="Only allow connections from addresses on your own network"
                              Margin="0,0,0,4"
                              AutomationProperties.Name="Only allow connections from private network addresses"
                              Click="EnforcePrivateIpCheck_Click"/>
                    <TextBlock TextWrapping="Wrap" Margin="20,0,0,8"
                               Text="Leave this on for a radio on an ordinary home network. Turn it off if you reach the radio over Tailscale or a similar service — those hand out addresses the radio does not count as local, so it will refuse the connection without saying why. Changing this needs a connected radio."/>

                    <!-- Sprint 27 Track C: full NetworkTest probe via SmartLink backend. Distinct from Te_st port above, which is local-only validation. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Network Diagnostic" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Asks Flex's SmartLink backend to probe your network from outside, then reports whether UPnP and manual port forwarding are reachable from the internet, and whether your NAT preserves source ports (the signal that decides whether hole-punch / Tier 3 can work). Requires an active radio connection and an authenticated SmartLink session. Results are cached for 5 minutes."/>

                    <TextBlock x:Name="NetworkDiagnosticResultText"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,8"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap"/>

                    <!-- Sprint 27 Track D: Test / Copy / Save / Help row + Verbose toggle. -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Test _network"
                                Width="150" Margin="0,0,8,0"
                                AutomationProperties.Name="Run a fresh SmartLink network diagnostic probe against the connected radio"
                                AutomationProperties.AcceleratorKey="Alt+N"
                                Click="TestNetworkButton_Click"/>
                        <Button Content="Copy _report"
                                Width="130" Margin="0,0,8,0"
                                AutomationProperties.Name="Copy the last network diagnostic report to the clipboard as markdown"
                                AutomationProperties.AcceleratorKey="Alt+R"
                                Click="CopyNetworkReportButton_Click"/>
                        <Button Content="Sa_ve report"
                                Width="130" Margin="0,0,8,0"
                                AutomationProperties.Name="Save the last network diagnostic report to a file"
                                AutomationProperties.AcceleratorKey="Alt+V"
                                Click="SaveNetworkReportButton_Click"/>
                        <Button Content="_Help"
                                Width="90"
                                AutomationProperties.Name="Open the help document relevant to the current network state"
                                AutomationProperties.AcceleratorKey="Alt+H"
                                Click="NetworkHelpButton_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="VerboseDiagnosticsCheck"
                              Content="Verbose network diagnostics (include raw details in status announcements)"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Enable verbose network diagnostic output"
                              Click="VerboseDiagnosticsCheck_Click"/>

                    <!-- Radio addressing. The same control also appears as a
                         numbered step in Radio Setup; this is the copy for people
                         who already know what they are looking for and came
                         straight here. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Radio Network Address" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <controls:StaticIpControl x:Name="NetworkStaticIpControl"/>

                    <!-- Learning the connection path (task #102).
                         App-level, not per-operator: the store it governs
                         (connect-history.json) is keyed by radio serial and
                         shared by every operator profile on this machine, so a
                         per-operator switch could only ever half-apply. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Learning Your Connection Path" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="When a radio connects the same way several times running, JJ Flexible can take the hint and try that way first next time. It only ever fills in a blank: if you have chosen a connection path for a radio yourself, on the Radios tab or in the radio picker, your choice wins and nothing here can change it."/>

                    <CheckBox x:Name="PathLearningEnabledCheck"
                              Content="Let JJ Flexible learn which connection path each radio prefers"
                              Margin="0,0,0,4"
                              AutomationProperties.Name="Learn which connection path each radio prefers"
                              local:JJFlexHelp.Text="With this off, JJ Flexible never prefills a connection path from a radio's history. Your own choices still apply, and radios you have not chosen a path for fall back to trying the local network first. Turn it off if you are often on the road, where half your connects say nothing about where you usually are. It does not stop the history being kept — that is the record behind the connection times, and it stays either way."
                              Checked="PathLearningEnabledCheck_Changed"
                              Unchecked="PathLearningEnabledCheck_Changed"/>

                    <StackPanel x:Name="PathLearningThresholdPanel"
                                Orientation="Horizontal" Margin="20,4,0,8">
                        <controls:DecorativeText Text="Connects in a row before it takes the hint:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="PathLearningThresholdCombo" Width="70"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Connects in a row before JJ Flexible takes the hint"
                                  local:JJFlexHelp.Text="Three, four or five. Higher means more evidence before JJ Flexible concludes anything, which is what you want if you are often travelling. Five is the ceiling and the reason is the store, not caution: JJ Flexible keeps the last ten connection attempts per radio, and a radio that tries one way and falls back to the other uses two of those ten every time it connects — so five successes in a row is the most such a radio could ever show. A larger number would be one this app could never reach."
                                  SelectionChanged="PathLearningThresholdCombo_SelectionChanged"/>
                    </StackPanel>

                    <TextBlock x:Name="PathLearningStatusText"
                               Style="{StaticResource DialogLabel}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               AutomationProperties.LiveSetting="Polite"/>

                    <Button x:Name="PathLearningForgetButton"
                            Content="Forget what has been _learned..."
                            HorizontalAlignment="Left" Padding="12,4"
                            AutomationProperties.Name="Forget what has been learned, for every radio"
                            AutomationProperties.AcceleratorKey="Alt+L"
                            local:JJFlexHelp.Text="Clears the connection history for every radio this computer knows, which is what JJ Flexible reads to work out a habit — so the habits go with it. It asks first and names what is lost. To do it for one radio only, press Shift F10 on that radio in the radio picker and choose Forget the learned connection path."
                            Click="PathLearningForgetButton_Click"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Radios tab — everything about a PARTICULAR radio, keyed by
                 serial (barefoot-punch-pathfinder 1b). Reachability belongs to
                 the radio's SITE, not the account, so this tab deliberately
                 works with NO radio connected — its whole reason to exist is
                 configuring how to reach a radio you cannot currently reach.
                 The nickname is the one exception: the name lives on the radio
                 itself, so pushing it needs a connection; offline edits update
                 only the local label and say so. -->
            <TabItem Header="Radios" AutomationProperties.Name="Per-radio settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8" Loaded="RadioProfileSection_Loaded">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Settings for each individual radio, remembered by serial number. Editable any time, connected or not. Radios appear here after you connect to them once, or type a serial number directly."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:DecorativeText Text="Radio:" VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="RadioProfilePicker" Width="280" IsEditable="True"
                                  AutomationProperties.Name="Radio to configure. Choose from known radios or type a serial number."
                                  SelectionChanged="RadioProfilePicker_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <controls:DecorativeText Text="Radio name:" VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="RadioProfileNicknameBox" Width="280"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="Radio name"
                   local:JJFlexHelp.Text="Applied with OK or Apply. Saved to the radio itself when you are connected to it; otherwise only the name shown in this list changes. Leaving this empty keeps the current name."/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Style="{StaticResource DialogLabel}"
                               Text="The name is stored on the radio itself and shows up everywhere — discovery, SmartLink, other clients. Applying while connected to this radio renames it for real; applying while not connected only changes the name shown here until the next connection."/>
                    <!-- Sprint 31 Track S (#94): whose radio this is. Sits right
                         after the name because it is identity, not networking —
                         and because it decides whether the rest of JJ Flex may
                         create anything on this radio. Deliberately NOT derived
                         from registration: you can be signed in with the owner's
                         own account and still be a guest, and a LAN-only radio
                         has no registration to reason from at all. -->
                    <GroupBox Header="Whose radio is this" Margin="0,4,0,8"
                              AutomationProperties.Name="Whose radio is this">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Some settings live on the radio itself and are shared by every program connected to it. Telling JJ Flex which radios are yours is what lets it set those up for you — and what keeps it from changing a friend's radio while you are borrowing it."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <controls:DecorativeText Text="This radio is:"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="RadioProfileOwnershipCombo" MinWidth="260"
                                          Style="{StaticResource DialogComboBox}"
                                          AutomationProperties.Name="Whose radio this is"
                   local:JJFlexHelp.Text="Marking a radio as yours lets JJ Flex create settings on the radio itself without stopping to ask each time — a mic profile, for instance. On any other radio it will still apply everything that lives on this computer, and will ask before creating anything on the radio. This is your word for it: JJ Flex does not check and cannot. It is here so you do not change a friend's radio by accident, not to stop you doing anything deliberately."
                                          SelectionChanged="RadioProfileOwnershipCombo_SelectionChanged">
                                    <ComboBoxItem Content="Ask me when it comes up"/>
                                    <ComboBoxItem Content="Mine"/>
                                    <ComboBoxItem Content="Someone else's"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                       Style="{StaticResource DialogLabel}"
                                       Text="Being able to reach a radio is not the same as owning it — you can be signed in with its owner's account and still be a guest, and a radio on your own network may have no account behind it at all. So JJ Flex asks instead of guessing. Settings you have already bound to a radio keep working whichever answer you give; this only decides whether new things may be created on it."/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Connection over SmartLink" Margin="0,4,0,8"
                              AutomationProperties.Name="Connection over SmartLink">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="How JJ Flex reaches this radio over SmartLink. These settings belong to the radio, not your account — one radio can use a forwarded port while another hole-punches."/>
                            <!-- The three mode radios are their own arrow-navigation
                                 group. Without this they shared the outer StackPanel
                                 with the hole-punch port field, so arrowing past the
                                 last radio walked straight OUT of the group and into a
                                 text box - an operator looking for a fourth option
                                 found themselves typing in a port field instead.
                                 Reported 2026-08-18. Cycle so the arrows wrap, which
                                 is what a radio group does everywhere else in Windows. -->
                            <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle"
                                        KeyboardNavigation.TabNavigation="Once">
                            <RadioButton x:Name="RadioProfileAutoRadio" GroupName="RadioProfileMode" Margin="0,4,0,4"
                                         AutomationProperties.Name="Automatic, follow what the radio reports. Recommended."
                                         Checked="RadioProfileMode_Checked">
                                <StackPanel>
                                    <TextBlock Text="Automatic (recommended)" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="JJ Flex follows what the radio reports about itself on every connection: if it advertises forwarded ports, they are used; if it says it needs a hole-punch, JJ Flex punches. No configuration needed."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RadioProfileForwardRadio" GroupName="RadioProfileMode" Margin="0,4,0,4"
                                         AutomationProperties.Name="Forwarded ports only, never hole punch"
                                         Checked="RadioProfileMode_Checked">
                                <StackPanel>
                                    <TextBlock Text="Forwarded ports only" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Always connect through the radio's forwarded public ports, even if the radio claims it needs a hole-punch. Use when you know a port forward exists and the radio's own report is wrong. If the radio truly has no reachable public ports, the connection will fail."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RadioProfilePunchRadio" GroupName="RadioProfileMode" Margin="0,4,0,4"
                                         AutomationProperties.Name="Hole punch always, never use forwarded ports"
                                         Checked="RadioProfileMode_Checked">
                                <StackPanel>
                                    <TextBlock Text="Hole-punch always" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Always coordinate a UDP hole-punch through SmartLink, even if the radio advertises forwarded ports. Mostly useful for testing the hole-punch path on a radio that would normally connect the easy way."/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                <controls:DecorativeText Text="Fixed hole-punch port (blank = new one each time):"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                                <TextBox x:Name="RadioProfilePunchPortBox" Width="90"
                                         Style="{StaticResource DialogTextBox}"
                                         AutomationProperties.Name="Fixed hole-punch port for this radio"
                   local:JJFlexHelp.Text="1024 to 65535, or blank to use a new random port for each connection"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <!-- Track C: "no physical access" — geography, not networking.
                         The SmartLink group above answers "how do I connect";
                         this answers "can a human reach the radio". Checking it
                         runs the enumerated cascade in code-behind. -->
                    <GroupBox Header="Reaching this radio" Margin="0,4,0,8"
                              AutomationProperties.Name="Reaching this radio">
                        <StackPanel Margin="4">
                            <CheckBox x:Name="RadioProfileNoPhysicalAccessCheck" Margin="0,0,0,4"
                                      Click="RadioProfileNoPhysicalAccess_Click"
                                      AutomationProperties.Name="This radio is operated remotely. I cannot reach its front panel.">
                                <TextBlock Text="This radio is operated remotely — I cannot reach its front panel" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock x:Name="RadioProfileNoPhysicalAccessHint"
                                       TextWrapping="Wrap" Margin="20,0,0,4"
                                       Style="{StaticResource DialogLabel}"/>
                            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                       Style="{StaticResource DialogLabel}"
                                       Text="This is about geography, not the connection: a radio at your own house can prefer SmartLink and still be a short walk away. Checking it offers to set the safety net a truly unreachable radio needs — REM ON and the remote administration allowances below."/>
                            <!-- Sprint 30 Track A: the local-only answer, made
                                 visible and reversible. A connect offers this
                                 once; this is where it lives afterwards. Three
                                 states rather than a checkbox, because "not
                                 local only" is genuinely two different answers
                                 — never asked, and asked and answered no. -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                                <controls:DecorativeText Text="Reaching this radio from away:"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="RadioProfileSmartLinkIntentCombo" MinWidth="260"
                                          Style="{StaticResource DialogComboBox}"
                                          AutomationProperties.Name="Whether you want to reach this radio from away"
                   local:JJFlexHelp.Text="Local only silences every SmartLink registration prompt for this radio. Registering with SmartLink is how you reach a radio over the internet from somewhere else — a radio that never leaves your house does not need it, and nothing about your local operating changes either way."
                                          SelectionChanged="RadioProfileSmartLinkIntentCombo_SelectionChanged">
                                    <ComboBoxItem Content="Ask me when it comes up"/>
                                    <ComboBoxItem Content="I only use this radio here"/>
                                    <ComboBoxItem Content="I want to reach it from away"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                       Style="{StaticResource DialogLabel}"
                                       Text="Registering a radio with SmartLink is how you reach it over the internet from somewhere else. A radio that never leaves your house does not need it. Choosing I only use this radio here settles the question for this radio and stops it being raised on connect; nothing about your local operating changes either way."/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Remote administration" Margin="0,4,0,8"
                              AutomationProperties.Name="Remote administration">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Normally, changes that persist on the radio — port settings, firmware — require being at the radio. If this radio lives somewhere you can never be, turn on what you need here. These choices apply to this radio only and are off unless you say otherwise."/>
                            <CheckBox x:Name="RadioProfileAllowRemotePortCheck" Margin="0,0,0,6"
                                      Checked="RadioProfileRemoteAdmin_Toggled"
                                      Unchecked="RadioProfileRemoteAdmin_Toggled"
                                      AutomationProperties.Name="Allow changing port settings from a remote connection"
                   local:JJFlexHelp.Text="Lets a remote connection change settings that persist on the radio itself, like port numbers. Getting a port wrong is recoverable — the radio stays registered with SmartLink, and hole punch remains a way back in.">
                                <TextBlock Text="Allow changing port settings from a remote connection" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="RadioProfileAllowRemoteFirmwareCheck" Margin="0,0,0,4"
                                      Checked="RadioProfileRemoteAdmin_Toggled"
                                      Unchecked="RadioProfileRemoteAdmin_Toggled"
                                      AutomationProperties.Name="Allow firmware updates without someone at the radio"
                   local:JJFlexHelp.Text="Lets a firmware update start with nobody at the radio. Firmware always travels over the radio's local network, so from afar this needs a VPN link like Tailscale — and interrupting an update is not recoverable. Leave it off unless it is truly your only option.">
                                <TextBlock Text="Allow firmware updates without someone at the radio" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                       Style="{StaticResource DialogLabel}"
                                       Text="Firmware always travels over the radio's local network, so updating from afar means a VPN link, like Tailscale, that makes your computer look local. Getting a port wrong is recoverable — the radio stays registered with SmartLink and hole-punch remains a way back in. Interrupting a firmware update is not, so leave that one off unless it is truly your only option."/>
                            <!-- Track C: REM ON as a queued intent. The TX Controls
                                 dialog can only reach it with a live connection —
                                 which is exactly when a remote radio being off makes
                                 it unreachable. This saves the intent with no radio
                                 present and applies it at the next connection. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <controls:DecorativeText Text="REM ON remote power jack when connecting:"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="RadioProfileRemOnCombo" MinWidth="220"
                                          Style="{StaticResource DialogComboBox}"
                                          AutomationProperties.Name="REM ON remote power jack when connecting to this radio"
                   local:JJFlexHelp.Text="Saved for this radio; applied at the next connection."
                                          SelectionChanged="RadioProfileRemOnCombo_SelectionChanged">
                                    <ComboBoxItem Content="Leave it as the radio has it"/>
                                    <ComboBoxItem Content="Turn it on"/>
                                    <ComboBoxItem Content="Turn it off"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                       Style="{StaticResource DialogLabel}"
                                       Text="REM ON lets the radio be powered up remotely, and for a radio nobody can walk to it is the only way back from powered-off. Hardware matters: enabling it does nothing unless the REM ON RCA jack on the radio's back panel is actually wired to a relay or keying device."/>
                        </StackPanel>
                    </GroupBox>
                    <!-- Track C: the per-feature "Save profile" button is gone.
                         Edits on this tab are committed by the dialog's Apply and
                         OK like every other setting — this is the fix for the
                         radio name that did not save. -->
                    <TextBlock x:Name="RadioProfileStatusText"
                               Style="{StaticResource DialogLabel}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Focusable="True"
                               AutomationProperties.Name="Radio profile status"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Radio Setup tab — the ordered path for bringing a radio up,
                 especially one that will live somewhere you cannot walk to.
                 Deliberately a numbered checklist and not a modal wizard: a
                 screen reader user can move by heading to any step, in any
                 order, and re-run a single step without walking a whole flow
                 again. Steps that are already satisfied say so, so the tab
                 doubles as a status board. -->
            <TabItem Header="Radio Setup" AutomationProperties.Name="Radio setup checklist">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="These steps get a radio ready to reach from somewhere else. Work down them in order the first time. Any step can be re-run on its own later, and each one reports where it currently stands."/>

                    <Button x:Name="RadioSetupRefreshButton"
                            Content="_Refresh all steps"
                            HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,12"
                            AutomationProperties.Name="Re-read the radio and update the status of every step"
                            AutomationProperties.AcceleratorKey="Alt+R"
                            Click="RadioSetupRefreshButton_Click"/>

                    <!-- Step 1 -->
                    <GroupBox Header="Step 1 — Connect to the radio" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 1, connect to the radio">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="The remaining steps change settings stored in the radio itself, so the radio has to be connected. Connect on the same local network as the radio where you can — a few of these steps cannot run over SmartLink."/>
                            <TextBlock x:Name="SetupConnectStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Connect status"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 2 — registration. Placed before everything except
                         connecting because it is the one step that can never be
                         done remotely: the radio demands a physical keypress. A
                         radio that leaves the house unregistered cannot be
                         registered from anywhere else. -->
                    <GroupBox Header="Step 2 — Register the radio with SmartLink" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 2, register the radio with SmartLink">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Registering ties the radio to your SmartLink account so you can reach it from away from home. The radio will ask you to key the microphone or the CW key to prove someone is standing at it. FlexRadio requires that and it cannot be done remotely — so a radio has to be registered before it goes anywhere you cannot reach."/>

                            <!-- Naming lives with registration on purpose: this is
                                 the moment a radio gets set up, and an unnamed radio
                                 is what gets mis-picked from the list later. The
                                 name is stored in the radio itself, so it needs a
                                 connection — but unlike registering, renaming works
                                 over SmartLink too, so it only gates on step 1. -->
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="While you are here, give the radio a name. The name lives in the radio itself and is what shows in the radio list and on SmartLink — an unnamed radio shows as Unknown and is easy to pick by mistake."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <controls:DecorativeText Text="Radio name:" VerticalAlignment="Center"
                                           Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                                <TextBox x:Name="SetupRadioNameBox"
                                         Width="220" VerticalAlignment="Center"
                                         Style="{StaticResource DialogTextBox}"
                                         AutomationProperties.Name="Radio name, stored in the radio itself"/>
                                <!-- Track C: renamed from "Apply name" — settings
                                     screens carry exactly one Apply (the dialog's
                                     own), so this is a do-it-now checklist action,
                                     not an apply variant. A name typed here and
                                     never sent still commits on the dialog's OK
                                     or Apply. -->
                                <Button x:Name="SetupApplyNameButton"
                                        Content="Set na_me now"
                                        Margin="8,0,0,0" Padding="12,4"
                                        AutomationProperties.Name="Set the name on the radio right now"
                                        AutomationProperties.AcceleratorKey="Alt+M"
                                        Click="SetupApplyNameButton_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="SetupRegisterStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Registration status"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SetupRegisterButton"
                                        Content="Re_gister this radio"
                                        Margin="0,0,8,0" Padding="12,4"
                                        AutomationProperties.Name="Register this radio with your SmartLink account"
                                        AutomationProperties.AcceleratorKey="Alt+G"
                                        Click="SetupRegisterButton_Click"/>
                                <Button x:Name="SetupUnregisterButton"
                                        Content="Unregister..."
                                        Padding="12,4"
                                        AutomationProperties.Name="Remove this radio's SmartLink registration"
                   local:JJFlexHelp.Text="Rarely wanted — re-registering needs someone at the radio."
                                        Click="SetupUnregisterButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 3 — firmware. Sits after registration and before the
                         network steps because an update reboots the radio and would
                         undo nothing else, but it is the step most likely to be
                         skipped, so it reports plainly whether it is needed. -->
                    <GroupBox Header="Step 3 — Radio firmware" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 3, radio firmware">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Firmware has to be sent over your local network — it does not go through SmartLink. So a radio that will live somewhere you cannot reach should be brought up to date before it goes."/>
                            <TextBlock x:Name="SetupFirmwareStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Firmware status"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="SetupGetFirmwareButton"
                                        Content="_Download firmware for this radio"
                                        Margin="0,0,8,0" Padding="12,4"
                                        AutomationProperties.Name="Look for firmware for this radio on the JJ Flexible servers and download it"
                                        AutomationProperties.AcceleratorKey="Alt+D"
                                        Click="SetupGetFirmwareButton_Click"/>
                                <Button x:Name="SetupChooseFirmwareButton"
                                        Content="C_hoose a file instead..."
                                        Margin="0,0,8,0" Padding="12,4"
                                        AutomationProperties.Name="Choose a firmware file already on this computer"
                                        AutomationProperties.AcceleratorKey="Alt+H"
                                        Click="SetupChooseFirmwareButton_Click"/>
                                <Button x:Name="SetupSendFirmwareButton"
                                        Content="Send to radio"
                                        IsEnabled="False" Padding="12,4"
                                        AutomationProperties.Name="Send the chosen firmware file to the radio"
                                        Click="SetupSendFirmwareButton_Click"/>
                            </StackPanel>
                            <!-- Real WPF ProgressBar rather than spoken percentages.
                                 NVDA announces progress bars using the user's own
                                 setting - beep, speak, both, or off - so the app
                                 deciding when to talk overrides a preference the
                                 user already expressed, and interrupts other speech
                                 to do it. The byte-count line below is a plain
                                 TextBlock, deliberately NOT a live region: it is
                                 there to be read on demand, not announced. -->
                            <ProgressBar x:Name="SetupFirmwareProgress"
                                         Height="18" Minimum="0" Maximum="100"
                                         Margin="0,0,0,4"
                                         Visibility="Collapsed"
                                         AutomationProperties.Name="Firmware download progress"/>
                            <TextBlock x:Name="SetupFirmwareProgressText"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       Visibility="Collapsed"
                                       AutomationProperties.Name="Firmware download bytes transferred"/>
                            <TextBlock x:Name="SetupFirmwareFileText"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Chosen firmware file"/>
                            <Button x:Name="SetupSuppressVersionWarningButton"
                                    Content="Stop reporting the version mismatch"
                                    HorizontalAlignment="Left" Padding="12,4"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="Stop reporting the firmware version mismatch"
                   local:JJFlexHelp.Text="Does not change the radio."
                                    Click="SetupSuppressVersionWarningButton_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 4 -->
                    <GroupBox Header="Step 4 — Give the radio a fixed address" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 4, give the radio a fixed address">
                        <StackPanel Margin="4">
                            <TextBlock x:Name="SetupAddressStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Address status"/>
                            <controls:StaticIpControl x:Name="SetupStaticIpControl"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 4 -->
                    <GroupBox Header="Step 5 — Open a way in from the internet" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 5, open a way in from the internet">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="To reach the radio from away from home, SmartLink needs a way through the router. A forwarded port is the most reliable and needs one change on the router. UPnP does the same thing automatically when the router allows it. Where the router cannot be changed at all, hole-punch can often get through on its own."/>
                            <TextBlock x:Name="SetupWayInStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Internet access status"/>
                            <Button x:Name="SetupGoToNetworkButton"
                                    Content="Open Net_work settings"
                                    HorizontalAlignment="Left" Padding="12,4"
                                    AutomationProperties.Name="Go to the Network tab to set the port"
                   local:JJFlexHelp.Text="connection mode and hole-punch port"
                                    AutomationProperties.AcceleratorKey="Alt+W"
                                    Click="SetupGoToNetworkButton_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 5 -->
                    <GroupBox Header="Step 6 — Check it from outside" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 6, check the radio can be reached from outside">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Asks SmartLink to look at your network from the outside and report what it can reach. Run this before you leave, while you can still change things."/>
                            <TextBlock x:Name="SetupCheckStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Outside check status"/>
                            <Button x:Name="SetupTestNetworkButton"
                                    Content="Run the network _test"
                                    HorizontalAlignment="Left" Padding="12,4"
                                    AutomationProperties.Name="Run the SmartLink network diagnostic"
                                    AutomationProperties.AcceleratorKey="Alt+T"
                                    Click="SetupTestNetworkButton_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 6 -->
                    <GroupBox Header="Step 7 — Restart the radio" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 7, restart the radio">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="A fixed address only takes effect after the radio restarts. Restarting is also the first thing to try when a radio you cannot reach has stopped answering."/>
                            <TextBlock x:Name="SetupRestartStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Restart status"/>
                            <Button x:Name="SetupRebootButton"
                                    Content="R_estart the radio"
                                    HorizontalAlignment="Left" Padding="12,4"
                                    AutomationProperties.Name="Restart the radio. Asks for confirmation first."
                                    AutomationProperties.AcceleratorKey="Alt+E"
                                    Click="SetupRebootButton_Click"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Verbosity & Notifications Tab -->
            <TabItem Header="Notifications" AutomationProperties.Name="Verbosity and notifications settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <!-- Speech section -->
                    <TextBlock Text="Speech" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:DecorativeText Text="Speech verbosity:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SpeechVerbosityCombo" Width="120"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Speech verbosity level"/>
                    </StackPanel>

                    <!-- Mic-audio verdict output (Audio Arc Keys Track, 2026-08-11).
                         Applies to Alt+Shift+S while transmitting and the
                         Ctrl+J, K mic check. Default is plain English plus
                         dBFS — what always shipped. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:DecorativeText Text="Mic audio readout:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="MicVerdictOutputCombo" Width="220"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Mic audio readout"
                   local:JJFlexHelp.Text="How spoken mic-audio checks read: plain English plus decibels, plain English only, or decibels only. Applies to the transmit status key and the JJ key mic check."/>
                    </StackPanel>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Earcons section -->
                    <TextBlock Text="Alert Sounds" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="EarconsEnabledCheck"
                              Content="Enable alert sounds (earcons)"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable alert sounds such as beeps and tones"
                   local:JJFlexHelp.Text="The master switch for every alert sound the app makes. The JJ key quick mute, Control J then Shift T, flips this same switch — and either way the choice is remembered next time you start. Meter tones and speech are separate and unaffected."/>

                    <!-- Per-category switches (Sprint 30, #43) — the finer
                         controls the earcon help page promised before they
                         existed. Indented under the master switch they answer
                         to; the master off silences everything regardless. -->
                    <StackPanel Margin="20,0,0,8">
                        <CheckBox x:Name="EarconConnectionCheck"
                                  Content="Connection sounds" Margin="0,0,0,4"
                                  AutomationProperties.Name="Connection sounds"
                   local:JJFlexHelp.Text="The counting tones while a connection is being made, and the double-beep when it lands."/>
                        <CheckBox x:Name="EarconTransmitCheck"
                                  Content="Transmit sounds" Margin="0,0,0,4"
                                  AutomationProperties.Name="Transmit sounds"
                   local:JJFlexHelp.Text="Transmit start and stop, the hard-kill warning, the tune carrier, and the antenna tuner's progress and verdict."/>
                        <CheckBox x:Name="EarconDialogsCheck"
                                  Content="Dialog and panel sounds" Margin="0,0,0,4"
                                  AutomationProperties.Name="Dialog and panel sounds"
                   local:JJFlexHelp.Text="The dings when a dialog opens or closes, and the sweeps when a Home panel expands or collapses."/>
                        <CheckBox x:Name="EarconTuningCheck"
                                  Content="Tuning and filter sounds" Margin="0,0,0,4"
                                  AutomationProperties.Name="Tuning and filter sounds"
                   local:JJFlexHelp.Text="Filter-edge clicks and sweeps, the band-boundary beep, and the frequency-entry ding."/>
                        <CheckBox x:Name="EarconCommandsCheck"
                                  Content="Command and confirmation sounds" Margin="0,0,0,4"
                                  AutomationProperties.Name="Command and confirmation sounds"
                   local:JJFlexHelp.Text="The JJ key layer's tones, feature on and off beeps, mute-all, and confirmations. Worth keeping — without them the JJ key gives no sign it is listening."/>
                        <CheckBox x:Name="EarconWarningsCheck"
                                  Content="Warning sounds" Margin="0,0,0,4"
                                  AutomationProperties.Name="Warning sounds"
                   local:JJFlexHelp.Text="The warning alarm — a long 800 hertz tone with harmonics, deliberately unlike anything else the app plays — and the quieter two-note tone that says a problem was recorded. This is the one worth leaving on. Every other sound here answers a key you just pressed; these two fire when the app has something to tell you that you did not ask about, such as transmit audio that would not have gone out."/>
                    </StackPanel>

                    <Separator Margin="0,4,0,8"/>

                    <!-- CW notifications moved to the Audio tab, 2026-08-07
                         (QB Track B). They play through the alert device, and
                         the switch belongs beside the device it uses. This
                         pointer stays for anyone who learned the old location —
                         a setting that has moved should say where it went, not
                         just vanish. -->
                    <TextBlock Text="CW Morse Notifications" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource DialogLabel}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Focusable="True"
                               Text="CW notification settings are on the Audio tab now, beside the alert device they play through."
                               AutomationProperties.Name="CW notification settings are on the Audio tab now"
                   local:JJFlexHelp.Text="beside the alert device they play through."/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Meter Tones enable (moved from Audio) -->
                    <TextBlock Text="Meter Tones" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="MeterTonesNotifCheck"
                              Content="Enable meter tones"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable meter tones"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Display elements -->
                    <TextBlock Text="Display" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ShowPanadapterCheck"
                              Content="Show panadapter / waterfall display"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Show the panadapter and waterfall display"
                   local:JJFlexHelp.Text="When unchecked, the display is hidden from view and removed from the tab order and braille refreshes are suppressed."/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Tune feedback -->
                    <TextBlock Text="Tune Feedback" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="AnnounceSwrAfterTuneCheck"
                              Content="Read final SWR reading after manual or automatic tune"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Read final SWR reading after manual or automatic tune."/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Connection progress -->
                    <TextBlock Text="Connection Progress" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="SpeakConnectionProgressCheck"
                              Content="Speak connection progress while connecting to a radio"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Speak connection progress"
                   local:JJFlexHelp.Text="When checked, JJ Flex announces each connection phase and plays a counting tone (1, 2, then 3 tones) as the connect proceeds. Critical messages (errors, cancel, timeout) always speak regardless of this setting."/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Sprint 28 Phase 1 — Accessibility Tab. Home for input-timing and
                 other accessibility-tuning preferences. Starts with DoubleTapTolerance;
                 future phases may add hold-to-repeat delay, announcement timing, etc. -->
            <TabItem Header="Accessibility" AutomationProperties.Name="Accessibility timing and input preferences">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <!-- Input Timing section -->
                    <TextBlock Text="Input Timing" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Double-tap tolerance controls how quickly you need to press a key twice for JJ Flex to recognize the second press as part of a double-tap. This affects filter-edge bracket double-tap (entering single-edge adjust mode) and Escape-Escape to collapse all field groups. Pick a setting that matches your typing cadence — faster if you tap quickly, slower if you verify speech between presses."/>

                    <GroupBox Header="Double-tap tolerance" Margin="0,0,0,8"
                              AutomationProperties.Name="Double-tap tolerance">
                        <StackPanel Margin="4">
                            <RadioButton x:Name="DoubleTapQuickRadio"
                                         GroupName="DoubleTapTolerance"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Quick, 250 milliseconds, for fast typists"
                                         Checked="DoubleTapToleranceRadio_Checked">
                                <TextBlock Text="Quick (250 ms)"/>
                            </RadioButton>
                            <RadioButton x:Name="DoubleTapNormalRadio"
                                         GroupName="DoubleTapTolerance"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Normal, 500 milliseconds, recommended default"
                                         Checked="DoubleTapToleranceRadio_Checked">
                                <TextBlock Text="Normal (500 ms, recommended)"/>
                            </RadioButton>
                            <RadioButton x:Name="DoubleTapRelaxedRadio"
                                         GroupName="DoubleTapTolerance"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Relaxed, 750 milliseconds, for deliberate input"
                                         Checked="DoubleTapToleranceRadio_Checked">
                                <TextBlock Text="Relaxed (750 ms)"/>
                            </RadioButton>
                            <RadioButton x:Name="DoubleTapLeisurelyRadio"
                                         GroupName="DoubleTapTolerance"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Leisurely, 1000 milliseconds, for verifying speech between presses"
                                         Checked="DoubleTapToleranceRadio_Checked">
                                <TextBlock Text="Leisurely (1000 ms)"/>
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Sprint 29 Track D — Updates tab. Channel selector, auto-check
                 toggles, manual "Check now," last-check timestamp. The
                 first-time-nightly consent dialog fires when the user picks
                 Nightly without having acknowledged it before. -->
            <TabItem Header="Updates" AutomationProperties.Name="Update channel and auto-check preferences">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="Update channel" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Stable is the public release channel. Beta gets milestone previews. Nightly tracks the very latest overnight build — useful for testers and for picking up fixes the same day, but it can be unstable."/>

                    <GroupBox Header="Channel" Margin="0,0,0,8"
                              AutomationProperties.Name="Update channel selector">
                        <StackPanel Margin="4">
                            <RadioButton x:Name="UpdateChannelStableRadio"
                                         GroupName="UpdateChannel"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Stable, public releases"
                                         Checked="UpdateChannelRadio_Checked">
                                <TextBlock Text="Stable (public releases)"/>
                            </RadioButton>
                            <RadioButton x:Name="UpdateChannelBetaRadio"
                                         GroupName="UpdateChannel"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Beta, milestone previews"
                                         Checked="UpdateChannelRadio_Checked">
                                <TextBlock Text="Beta (milestone previews)"/>
                            </RadioButton>
                            <RadioButton x:Name="UpdateChannelNightlyRadio"
                                         GroupName="UpdateChannel"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Nightly, overnight builds, may be unstable"
                                         Checked="UpdateChannelRadio_Checked">
                                <TextBlock Text="Nightly (overnight builds, may be unstable)"/>
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="UpdateAutoCheckCheckbox"
                              Content="Check for updates when JJ Flex starts"
                              Margin="0,0,0,4"
                              AutomationProperties.Name="Check for updates when JJ Flex starts"/>
                    <CheckBox x:Name="UpdatePeriodicCheckCheckbox"
                              Content="Check every two hours while JJ Flex is running"
                              Margin="0,0,0,12"
                              AutomationProperties.Name="Check every two hours while JJ Flex is running"/>

                    <TextBlock x:Name="UpdateLastCheckText"
                               Text="Last check: never"
                               Margin="0,0,0,8"
                               AutomationProperties.Name="Last update check timestamp"/>

                    <Button x:Name="UpdateCheckNowButton"
                            Content="Check for updates now"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            AutomationProperties.Name="Check for updates now"
                            Click="UpdateCheckNowButton_Click"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Sprint 30 Track D — Diagnostics tab. The configuration half of
                 the diagnostic log surface ratified in
                 docs/planning/active/diagnostic-log-surface.md. The archive half
                 is the Saved Diagnostic Logs window, one button away.

                 Two deliberate departures from the ratified text, both because
                 the design predates the 2026-08-18 HelpText finding:

                 1. The per-level explanations are VISIBLE static text, not
                    AccessibleDescription. NVDA reads HelpText as the control's
                    description on every focus, so an explanation parked there is
                    recited every time the operator tabs past it. As body text it
                    is read once when the tab opens and stays available.
                 2. The folder measurement is on a button, not automatic. Walking
                    a 2.2 GB tree on tab entry would stall the dialog, and a
                    stall is indistinguishable from a hang to someone who cannot
                    see a spinner. -->
            <TabItem Header="Diagnostics"
                     AutomationProperties.Name="Diagnostics, diagnostic log and problem reporting settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8"
                            Loaded="DiagnosticsPanel_Loaded"
                            IsVisibleChanged="DiagnosticsPanel_IsVisibleChanged">

                    <!-- The one sentence that answers "what is being recorded,
                         at what detail, and is a capture running" — the question
                         the retired dialog could not answer at all. -->
                    <TextBlock x:Name="DiagStatusText"
                               TextWrapping="Wrap" FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               Text="Diagnostic log state is not available."
                               AutomationProperties.Name="Diagnostic log status"/>

                    <!-- Sprint 31 Track Q (#100) — the count that makes the
                         Problems list discoverable without knowing the chord.
                         First group on the tab on purpose: when an operator
                         comes to this tab it is almost always because something
                         has already gone wrong, and this is the answer to
                         "what?". -->
                    <GroupBox Header="Problems this session" Margin="0,0,0,8"
                              AutomationProperties.Name="Problems this session">
                        <StackPanel Margin="4">
                            <TextBlock x:Name="DiagProblemCountText"
                                       TextWrapping="Wrap" Margin="0,4,0,6"
                                       Text="No problems recorded this session."
                                       AutomationProperties.Name="Problems recorded this session"/>
                            <Button x:Name="DiagShowProblemsButton"
                                    Content="Show recorded problems..."
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,6"
                                    AutomationProperties.Name="Show recorded problems"
                   local:JJFlexHelp.Text="Opens the list of everything that has gone wrong since JJ Flex started, newest first, with the time and what each one means. Control J then Control R opens the same list from anywhere. The list empties when you close JJ Flex; the diagnostic log is the record that keeps."
                                    Click="DiagShowProblemsButton_Click"/>
                            <TextBlock TextWrapping="Wrap"
                                       Text="When something fails, JJ Flex plays a short sound and says so once, without opening anything or taking you away from what you were doing. It is recorded either way, so missing that announcement costs you nothing — press Control J then Control R whenever you want to read what happened."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Diagnostic log" Margin="0,0,0,8"
                              AutomationProperties.Name="Diagnostic log">
                        <StackPanel Margin="4">
                            <CheckBox x:Name="DiagKeepLogCheckbox"
                                      Content="Keep a diagnostic log (recommended)"
                                      Margin="0,4,0,8"
                                      AutomationProperties.Name="Keep a diagnostic log, recommended"
                   local:JJFlexHelp.Text="Keeps a quiet record of what the app does, at the detail level below, so a problem that already happened can still be explained. It stays on this computer."
                                      Checked="DiagKeepLogCheckbox_Changed"
                                      Unchecked="DiagKeepLogCheckbox_Changed"/>

                            <TextBlock Text="Detail level" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <RadioButton x:Name="DiagDetailNormalRadio"
                                         GroupName="DiagDetail"
                                         Content="Normal (recommended)"
                                         Margin="0,2,0,0"
                                         AutomationProperties.Name="Normal detail, recommended"
                   local:JJFlexHelp.Text="Records connections, errors, and the actions you take. You will never notice the cost."
                                         Checked="DiagDetailRadio_Checked"/>
                            <TextBlock TextWrapping="Wrap" Margin="20,0,0,6"
                                       Text="Records connections, errors, and the actions you take. You will never notice the cost."/>
                            <RadioButton x:Name="DiagDetailDetailedRadio"
                                         GroupName="DiagDetail"
                                         Content="Detailed"
                                         Margin="0,2,0,0"
                                         AutomationProperties.Name="Detailed"
                   local:JJFlexHelp.Text="Records nearly everything the app does. Files grow fast. Use it when the developer asks, or use a detailed capture instead."
                                         Checked="DiagDetailRadio_Checked"/>
                            <TextBlock TextWrapping="Wrap" Margin="20,0,0,8"
                                       Text="Records nearly everything the app does. Files grow fast. Use it when the developer asks, or use a detailed capture instead."/>

                            <TextBlock x:Name="DiagPathText"
                                       TextWrapping="Wrap" Margin="0,4,0,6"
                                       Text="The live log location is not available."
                                       AutomationProperties.Name="Where the diagnostic log is kept"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="DiagCopyPathButton"
                                        Content="Copy log file path"
                                        Padding="12,4" Margin="0,0,8,0"
                                        AutomationProperties.Name="Copy log file path"
                   local:JJFlexHelp.Text="Puts the live log file's full path on the clipboard, ready to paste into a message or a file dialog."
                                        Click="DiagCopyPathButton_Click"/>
                                <Button x:Name="DiagOpenFolderButton"
                                        Content="Open log folder"
                                        Padding="12,4"
                                        AutomationProperties.Name="Open log folder"
                   local:JJFlexHelp.Text="Opens the folder that holds the live log in File Explorer."
                                        Click="DiagOpenFolderButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Detailed capture" Margin="0,0,0,8"
                              AutomationProperties.Name="Detailed capture">
                        <StackPanel Margin="4">
                            <Button x:Name="DiagCaptureButton"
                                    Content="Start detailed capture"
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,4,0,6"
                                    AutomationProperties.Name="Start detailed capture"
                   local:JJFlexHelp.Text="Records everything at maximum detail while you reproduce a problem, then press it again to stop. The capture saves as its own session in Saved Diagnostic Logs. Control J then Control D does the same from anywhere, radio or not."
                                    Click="DiagCaptureButton_Click"/>
                            <!-- Collapsed, not disabled: a disabled control stays
                                 in the tab order and a hidden one does not, and
                                 this button is meaningless until a capture has
                                 actually produced something to export. -->
                            <Button x:Name="DiagExportCaptureButton"
                                    Content="Export this capture..."
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,6"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="Export this capture"
                   local:JJFlexHelp.Text="Saves the capture you just finished as one file you can attach to a message or hand to support."
                                    Click="DiagExportCaptureButton_Click"/>
                            <TextBlock TextWrapping="Wrap"
                                       Text="A capture records everything at maximum detail while you reproduce a problem, then saves it as its own session in Saved Diagnostic Logs. Control J then Control D starts and stops one from anywhere."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Saved diagnostic logs" Margin="0,0,0,8"
                              AutomationProperties.Name="Saved diagnostic logs">
                        <StackPanel Margin="4">
                            <Button x:Name="DiagBrowseButton"
                                    Content="Browse saved logs..."
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,4,0,6"
                                    AutomationProperties.Name="Browse saved logs"
                   local:JJFlexHelp.Text="Opens the Saved Diagnostic Logs window, where every past session can be read, exported, or deleted."
                                    Click="DiagBrowseButton_Click"/>
                            <Button x:Name="DiagProblemReportButton"
                                    Content="Save a problem report bundle..."
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,6"
                                    AutomationProperties.Name="Save a problem report bundle"
                   local:JJFlexHelp.Text="Gathers the recent sessions and a snapshot of your setup into one bundle file, ready to send when the developer asks what happened. Nothing is sent for you."
                                    Click="DiagProblemReportButton_Click"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Each session is compressed and kept for 30 days, then removed automatically. Yesterday's sessions stay readable as plain text for one day."/>
                            <TextBlock TextWrapping="Wrap"
                                       AutomationProperties.Name="Privacy note"
                                       Text="The diagnostic log stays on this computer. It can include your callsign, contacted callsigns, your SmartLink email, network addresses, and your radio's serial number. When you export a session or save a problem report, you are choosing to share whatever that session recorded — review it first if that matters to you. Nothing is ever sent automatically."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Disk space" Margin="0,0,0,8"
                              AutomationProperties.Name="Disk space used by diagnostics">
                        <StackPanel Margin="4">
                            <TextBlock x:Name="DiagStorageText"
                                       TextWrapping="Wrap" Margin="0,4,0,6"
                                       Text="Choose Measure now to see what the settings folder is holding."
                                       AutomationProperties.Name="Settings folder size"/>
                            <TextBlock x:Name="DiagCrashText"
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Crash reports have not been counted yet."
                                       AutomationProperties.Name="Saved crash reports"/>
                            <Button x:Name="DiagMeasureButton"
                                    Content="Measure now"
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,6"
                                    AutomationProperties.Name="Measure the settings folder now"
                   local:JJFlexHelp.Text="Adds up what the settings folder is holding, including saved logs and crash reports. It runs when you ask because a large folder takes a moment to count."
                                    Click="DiagMeasureButton_Click"/>
                            <Button x:Name="DiagDeleteLooseButton"
                                    Content="Delete loose log text files"
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,6"
                                    AutomationProperties.Name="Delete loose log text files"
                   local:JJFlexHelp.Text="Removes leftover plain-text log files. The compressed sessions in Saved Diagnostic Logs are not touched, so nothing you might need is lost."
                                    Click="DiagDeleteLooseButton_Click"/>
                            <Button x:Name="DiagDeleteSentCrashButton"
                                    Content="Delete crash reports I have sent or dismissed"
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,6"
                                    AutomationProperties.Name="Delete crash reports I have sent or dismissed"
                   local:JJFlexHelp.Text="Removes only the crash reports you have already sent or dismissed. A report you have never dealt with is kept, because its whole value is being there when support asks."
                                    Click="DiagDeleteSentCrashButton_Click"/>
                            <TextBlock TextWrapping="Wrap"
                                       Text="Deleting loose log text does not touch the compressed sessions in Saved Diagnostic Logs, so nothing is lost. A crash report you have never sent or dismissed is never deleted automatically."/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</local:JJFlexDialog>
