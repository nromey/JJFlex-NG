<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:JJFlexWpf"
    xmlns:controls="clr-namespace:JJFlexWpf.Controls"
    Title="Settings"
    Width="460" Height="540"
    ResizeMode="NoResize"
    AutomationProperties.Name="Settings">
    <DockPanel Margin="12">
        <!-- Buttons at bottom -->
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ButtonPanel}">
            <Button Content="_OK" AutomationProperties.AcceleratorKey="Alt+O" Style="{StaticResource OkButton}"
                    AutomationProperties.Name="OK"
                    Click="OkButton_Click"/>
            <Button Content="_Cancel" AutomationProperties.AcceleratorKey="Alt+C" Style="{StaticResource CancelButton}"
                    AutomationProperties.Name="Cancel"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Tab control -->
        <TabControl x:Name="SettingsTabs"
                    AutomationProperties.Name="Settings categories">
            <!-- PTT Tab -->
            <TabItem Header="PTT" AutomationProperties.Name="Push to talk settings">
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Timeout (seconds):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PttTimeoutBox" Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="PTT timeout in seconds, 10 to 900"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="First warning (seconds before timeout):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PttWarning1Box" Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="First warning, seconds before timeout"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Second warning (seconds before timeout):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PttWarning2Box" Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="Second warning, seconds before timeout"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Final warning (seconds before timeout):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PttOhCrapBox" Grid.Row="3" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="Final warning, seconds before timeout"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="ALC auto-release (seconds, 0=off):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PttAlcBox" Grid.Row="4" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="ALC auto-release seconds, 0 to disable or 10 to 300"/>
                    </Grid>

                    <CheckBox x:Name="PttSpeechCheckbox"
                              Content="Announce transmit and receive state changes"
                              Margin="0,12,0,0"
                              AutomationProperties.Name="Announce transmit and receive state changes"/>

                    <CheckBox x:Name="ChirpEnabledCheckbox"
                              Content="Play chirp tones on transmit and receive"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Play chirp tones on transmit and receive"/>
                </StackPanel>
            </TabItem>

            <!-- Tuning Tab -->
            <TabItem Header="Tuning" AutomationProperties.Name="Tuning settings">
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Coarse step default:"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <ComboBox x:Name="CoarseStepCombo" Grid.Row="0" Grid.Column="1"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Default coarse tuning step"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Fine step default:"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <ComboBox x:Name="FineStepCombo" Grid.Row="1" Grid.Column="1"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Default fine tuning step"/>
                    </Grid>

                    <CheckBox x:Name="BandMemoryCheckbox"
                              Content="Enable band memory"
                              IsChecked="True" Margin="0,12,0,0"
                              AutomationProperties.Name="Enable band memory"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Frequency speech units:" VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="FreqUnitsCombo" Width="120"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Frequency speech units"/>
                    </StackPanel>

                    <Separator Margin="0,8,0,8"/>

                    <Button Content="Edit _Filter Presets..."
                            Width="160" HorizontalAlignment="Left"
                            AutomationProperties.Name="Edit filter presets"
                            AutomationProperties.AcceleratorKey="Alt+F"
                            Click="EditFilterPresetsButton_Click"/>

                    <Separator Margin="0,8,0,8"/>

                    <CheckBox x:Name="TuneDebounceCheckbox"
                              Content="Debounce tuning speech (group rapid steps)"
                              Margin="0,12,0,0"
                              AutomationProperties.Name="Debounce tuning speech, groups rapid tuning steps into one announcement"
                              Checked="TuneDebounceCheckbox_Changed"
                              Unchecked="TuneDebounceCheckbox_Changed"/>

                    <StackPanel x:Name="DebounceDelayPanel" Orientation="Horizontal" Margin="20,8,0,0">
                        <TextBlock Text="Debounce delay (ms):" VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="DebounceDelayBox" Width="60"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="Debounce delay in milliseconds, 50 to 1000"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- License Tab -->
            <TabItem Header="License" AutomationProperties.Name="License settings">
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="License class:"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <ComboBox x:Name="LicenseClassCombo" Grid.Row="0" Grid.Column="1"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="FCC license class"/>
                    </Grid>

                    <CheckBox x:Name="BandBoundaryCheckbox"
                              Content="Band boundary notifications"
                              Margin="0,12,0,0"
                              AutomationProperties.Name="Notify when tuning near band boundaries"/>
                    <CheckBox x:Name="TxLockoutCheckbox"
                              Content="TX band lockout"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Prevent transmitting outside licensed bands"/>

                    <Separator Margin="0,12,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Country:" VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CountryCombo" Width="120"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Country for 60 meter channelization rules"/>
                    </StackPanel>

                    <CheckBox x:Name="EnforceTxRulesCheckbox"
                              Content="Enforce transmit rules (60m channels, power limits)"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Enforce transmit parameters based on published amateur radio rules"/>
                </StackPanel>
            </TabItem>

            <!-- Audio Tab (merged: alerts, meters, master volume) -->
            <TabItem Header="Audio" AutomationProperties.Name="Audio settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <!-- Master Volume -->
                    <controls:ValueFieldControl x:Name="MasterVolumeControl"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="Master volume, 0 to 100, scales all audio"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Alert section -->
                    <TextBlock Text="Alerts" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <controls:ValueFieldControl x:Name="EarconVolumeControl"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="Alert volume, 0 to 100"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Alert device:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="EarconDeviceCombo" Width="200"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Alert audio output device"/>
                    </StackPanel>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Meter section -->
                    <TextBlock Text="Meter Tones" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <controls:ValueFieldControl x:Name="MeterVolumeControl"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="Meter tone volume, 0 to 100"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Meter device:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="MeterDeviceCombo" Width="200"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Meter tone audio output device"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Preset:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="MeterPresetCombo" Width="150"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Meter tone preset"/>
                    </StackPanel>
                    <CheckBox x:Name="PeakWatcherCheck"
                              Content="Peak Watcher ALC alerts"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable Peak Watcher ALC alerts"/>
                    <CheckBox x:Name="MeterSpeechCheck"
                              Content="Meter speech readout"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable meter speech readout"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Typing sound -->
                    <TextBlock Text="Frequency Entry" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Typing sound:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TypingSoundCombo" Width="180"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Frequency entry typing sound mode"/>
                    </StackPanel>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Braille Display section -->
                    <TextBlock Text="Braille Display" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="BrailleEnabledCheck"
                              Content="Enable braille status line"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable braille status line on home position"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Display cells:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="BrailleCellsCombo" Width="80"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Braille display cell count"/>
                    </StackPanel>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Audio Workshop shortcut -->
                    <Button Content="Audio _Workshop..."
                            Width="160" HorizontalAlignment="Left"
                            AutomationProperties.Name="Audio Workshop"
                            AutomationProperties.AcceleratorKey="Alt+W"
                            Click="AudioWorkshopButton_Click"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Network Tab (SmartLink port forwarding) -->
            <TabItem Header="Network" AutomationProperties.Name="Network and SmartLink settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="SmartLink Port Forwarding (Tier 1)" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Configure the radio's firmware to listen on a specific port for SmartLink. Your router must also forward the same TCP and UDP port to the radio's LAN IP address. Requires an active radio connection."/>

                    <!-- Sprint 27 Track A: Tier 1 framing prose. Explains what this mode means and why it's the recommended default. -->
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Tier 1 (Manual Port Forwarding) is the recommended default. You choose a port, forward it on your router to the radio's LAN IP, and JJ Flex tells the radio to listen on that port. Tier 1 is sovereign — there is no third-party coordination, no UPnP, and no hole-punch. It is the only tier compatible with organizational security policies that require UPnP disabled (DISA STIGs, PCI-DSS, HIPAA), and it is the most reliable path through strict NAT configurations. Your chosen port is saved with your SmartLink account; on future connections, JJ Flex applies it automatically."/>

                    <TextBlock x:Name="NetworkCurrentStateText"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,8"
                               AutomationProperties.LiveSetting="Polite"/>

                    <CheckBox x:Name="PortForwardEnabledCheck"
                              Content="Enable manual port forwarding"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable manual port forwarding on the radio"
                              Click="PortForwardEnabledCheck_Click"/>

                    <Grid Margin="20,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Port (TCP and UDP):"
                                   x:Name="PortForwardTcpLabel"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PortForwardTcpBox" Grid.Row="0" Grid.Column="1"
                                 Text="4992"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="Port number, 1024 to 65535, applied to TCP and UDP"
                                 TextChanged="PortForwardTcpBox_TextChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="UDP port:"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="PortForwardUdpBox" Grid.Row="1" Grid.Column="1"
                                 Text="4992" IsEnabled="False"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="UDP port number, 1024 to 65535"/>
                    </Grid>

                    <CheckBox x:Name="PortForwardSeparatePortsCheck"
                              Content="Use different TCP and UDP ports (advanced)"
                              Margin="20,0,0,8"
                              AutomationProperties.Name="Allow different TCP and UDP ports"
                              Checked="PortForwardSeparatePortsCheck_Changed"
                              Unchecked="PortForwardSeparatePortsCheck_Changed"/>

                    <!-- Sprint 27 Track A: Apply + Test side-by-side. Test performs local validation only (range + common-conflict blocklist) without touching the radio or persisting. -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="_Apply to connected radio"
                                Width="220" Margin="0,0,8,0"
                                AutomationProperties.Name="Apply port forwarding to connected radio and save as account preference"
                                AutomationProperties.AcceleratorKey="Alt+A"
                                Click="ApplyPortForwardButton_Click"/>
                        <Button Content="Te_st port"
                                Width="120"
                                AutomationProperties.Name="Test the port number locally for validity and common conflicts"
                                AutomationProperties.AcceleratorKey="Alt+S"
                                Click="TestPortButton_Click"/>
                    </StackPanel>

                    <!-- Sprint 27 Track F: Connection mode three-option radio group. Replaces B.2's single UPnP checkbox. Three cumulative tiers: manual-only (Tier 1), manual + UPnP (Tier 1+2), manual + UPnP + hole-punch (Tier 1+2+3). Tier 2 and Tier 3 options are gated on a valid Tier 1 port being configured. -->
                    <Separator Margin="0,16,0,8"/>
                    <GroupBox Header="Connection mode" Margin="0,0,0,8"
                              AutomationProperties.Name="SmartLink connection mode">
                        <StackPanel Margin="4">
                            <RadioButton x:Name="Tier1Radio"
                                         GroupName="ConnectionMode"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Tier 1, manual port forwarding only. Sovereign default."
                                         Checked="ConnectionModeRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="Tier 1 — Manual port forwarding only (recommended default)" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="You forward the port configured above on your router. No UPnP, no hole-punch. The only mode compatible with strict security policies (DISA STIGs, PCI-DSS, HIPAA) and the most reliable path through picky NATs."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Tier2Radio"
                                         GroupName="ConnectionMode"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Tier 1 plus 2, manual plus UPnP automatic port mapping"
                                         Checked="ConnectionModeRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="Tier 1 + 2 — Manual + UPnP" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="The radio asks your router via UPnP to open the port automatically. JJ Flex does not do this itself and cannot turn UPnP on — if your router has UPnP switched off, that is a change on the router, not here. UPnP is also convenient in a way worth knowing about: it lets any program on your network open a way in without asking, which is why many routers and most workplace networks disable it. If UPnP does not work, JJ Flex falls back to Tier 1."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Tier3Radio"
                                         GroupName="ConnectionMode"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Tier 1 plus 2 plus 3, allow automatic hole punch for restrictive networks"
                                         Checked="ConnectionModeRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="Tier 1 + 2 + 3 — Allow automatic hole-punch" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="If direct port forwarding or UPnP is not working, let Flex's SmartLink coordinate a UDP hole-punch between the radio and JJ Flex. Works through most home NATs. May fail on symmetric-NAT networks (some corporate environments and mobile-carrier networks). Fallback to Tier 2 then Tier 1 on failure is automatic."/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>

                    <!-- Legacy checkbox kept hidden for backward binding during the F.0/F.1 transition. The radio group above is the canonical UI. Will be removed in F.3 rollup cleanup if still present. -->
                    <CheckBox x:Name="UPnPEnabledCheck" Visibility="Collapsed" IsEnabled="False"/>

                    <!-- Hole-punch port. Kept next to the tier selector because Tier 3
                         is the only mode that uses it. Default is a fresh random port
                         per connection: reusing one risks colliding with a stale NAT
                         mapping, which makes hole-punch fail intermittently and in a
                         way that is miserable to reproduce. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Hole-punch Port" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Used only when the radio reports it needs a hole-punch. Leaving this blank is recommended — JJ Flex then picks a fresh port for every connection, which avoids clashing with a leftover mapping in the router from a previous session. Set a fixed port only if you have a reason to."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Port (blank = new one each time):"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="HolePunchPortBox" Width="90"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="Hole-punch port, 1024 to 65535, or blank to use a new random port for each connection"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Pick a random port"
                                Margin="0,0,8,0" Padding="10,4"
                                AutomationProperties.Name="Fill the hole-punch port with a random value"
                                Click="RandomHolePunchPortButton_Click"/>
                        <Button Content="Clear (new port each time)"
                                Margin="0,0,8,0" Padding="10,4"
                                AutomationProperties.Name="Clear the fixed hole-punch port so a new one is used for every connection"
                                Click="ClearHolePunchPortButton_Click"/>
                        <Button Content="Save port"
                                Padding="10,4"
                                AutomationProperties.Name="Save the hole-punch port with your SmartLink account"
                                Click="SaveHolePunchPortButton_Click"/>
                    </StackPanel>

                    <!-- What the radio and SmartLink actually report, as opposed to
                         what has been configured. The two differ constantly, and the
                         difference is the whole story when a connection will not
                         come up. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="What the Radio Reports" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Live facts from the radio and from SmartLink, rather than what is configured above. When a connection will not come up, the gap between the two is usually the answer."/>
                    <TextBlock x:Name="ReachabilityStatusText"
                               Style="{StaticResource DialogLabel}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="What the radio reports about its reachability"/>
                    <Button Content="Refresh what the radio reports"
                            HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,8"
                            AutomationProperties.Name="Re-read the radio's reachability status"
                            Click="RefreshReachabilityButton_Click"/>

                    <!-- Private-IP enforcement. Surfaced because Tailscale hands out
                         CGNAT addresses (100.64.x.x), which are not private addresses
                         in the sense the radio means — with this on, a tailnet client
                         gets refused with no useful explanation. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Who May Connect" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="EnforcePrivateIpCheck"
                              Content="Only allow connections from addresses on your own network"
                              Margin="0,0,0,4"
                              AutomationProperties.Name="Only allow connections from private network addresses"
                              Click="EnforcePrivateIpCheck_Click"/>
                    <TextBlock TextWrapping="Wrap" Margin="20,0,0,8"
                               Text="Leave this on for a radio on an ordinary home network. Turn it off if you reach the radio over Tailscale or a similar service — those hand out addresses the radio does not count as local, so it will refuse the connection without saying why. Changing this needs a connected radio."/>

                    <!-- Sprint 27 Track C: full NetworkTest probe via SmartLink backend. Distinct from Te_st port above, which is local-only validation. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Network Diagnostic" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Asks Flex's SmartLink backend to probe your network from outside, then reports whether UPnP and manual port forwarding are reachable from the internet, and whether your NAT preserves source ports (the signal that decides whether hole-punch / Tier 3 can work). Requires an active radio connection and an authenticated SmartLink session. Results are cached for 5 minutes."/>

                    <TextBlock x:Name="NetworkDiagnosticResultText"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,8"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap"/>

                    <!-- Sprint 27 Track D: Test / Copy / Save / Help row + Verbose toggle. -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Test _network"
                                Width="150" Margin="0,0,8,0"
                                AutomationProperties.Name="Run a fresh SmartLink network diagnostic probe against the connected radio"
                                AutomationProperties.AcceleratorKey="Alt+N"
                                Click="TestNetworkButton_Click"/>
                        <Button Content="Copy _report"
                                Width="130" Margin="0,0,8,0"
                                AutomationProperties.Name="Copy the last network diagnostic report to the clipboard as markdown"
                                AutomationProperties.AcceleratorKey="Alt+R"
                                Click="CopyNetworkReportButton_Click"/>
                        <Button Content="Sa_ve report"
                                Width="130" Margin="0,0,8,0"
                                AutomationProperties.Name="Save the last network diagnostic report to a file"
                                AutomationProperties.AcceleratorKey="Alt+V"
                                Click="SaveNetworkReportButton_Click"/>
                        <Button Content="_Help"
                                Width="90"
                                AutomationProperties.Name="Open the help document relevant to the current network state"
                                AutomationProperties.AcceleratorKey="Alt+H"
                                Click="NetworkHelpButton_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="VerboseDiagnosticsCheck"
                              Content="Verbose network diagnostics (include raw details in status announcements)"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Enable verbose network diagnostic output"
                              Click="VerboseDiagnosticsCheck_Click"/>

                    <!-- Radio addressing. The same control also appears as a
                         numbered step in Radio Setup; this is the copy for people
                         who already know what they are looking for and came
                         straight here. -->
                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Radio Network Address" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <controls:StaticIpControl x:Name="NetworkStaticIpControl"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Radio Setup tab — the ordered path for bringing a radio up,
                 especially one that will live somewhere you cannot walk to.
                 Deliberately a numbered checklist and not a modal wizard: a
                 screen reader user can move by heading to any step, in any
                 order, and re-run a single step without walking a whole flow
                 again. Steps that are already satisfied say so, so the tab
                 doubles as a status board. -->
            <TabItem Header="Radio Setup" AutomationProperties.Name="Radio setup checklist">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="These steps get a radio ready to reach from somewhere else. Work down them in order the first time. Any step can be re-run on its own later, and each one reports where it currently stands."/>

                    <Button x:Name="RadioSetupRefreshButton"
                            Content="_Refresh all steps"
                            HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,12"
                            AutomationProperties.Name="Re-read the radio and update the status of every step"
                            AutomationProperties.AcceleratorKey="Alt+R"
                            Click="RadioSetupRefreshButton_Click"/>

                    <!-- Step 1 -->
                    <GroupBox Header="Step 1 — Connect to the radio" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 1, connect to the radio">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="The remaining steps change settings stored in the radio itself, so the radio has to be connected. Connect on the same local network as the radio where you can — a few of these steps cannot run over SmartLink."/>
                            <TextBlock x:Name="SetupConnectStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Connect status"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 2 — registration. Placed before everything except
                         connecting because it is the one step that can never be
                         done remotely: the radio demands a physical keypress. A
                         radio that leaves the house unregistered cannot be
                         registered from anywhere else. -->
                    <GroupBox Header="Step 2 — Register the radio with SmartLink" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 2, register the radio with SmartLink">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Registering ties the radio to your SmartLink account so you can reach it from away from home. The radio will ask you to key the microphone or the CW key to prove someone is standing at it. FlexRadio requires that and it cannot be done remotely — so a radio has to be registered before it goes anywhere you cannot reach."/>
                            <TextBlock x:Name="SetupRegisterStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Registration status"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SetupRegisterButton"
                                        Content="Re_gister this radio"
                                        Margin="0,0,8,0" Padding="12,4"
                                        AutomationProperties.Name="Register this radio with your SmartLink account"
                                        AutomationProperties.AcceleratorKey="Alt+G"
                                        Click="SetupRegisterButton_Click"/>
                                <Button x:Name="SetupUnregisterButton"
                                        Content="Unregister..."
                                        Padding="12,4"
                                        AutomationProperties.Name="Remove this radio's SmartLink registration. Rarely wanted — re-registering needs someone at the radio."
                                        Click="SetupUnregisterButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 3 — firmware. Sits after registration and before the
                         network steps because an update reboots the radio and would
                         undo nothing else, but it is the step most likely to be
                         skipped, so it reports plainly whether it is needed. -->
                    <GroupBox Header="Step 3 — Radio firmware" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 3, radio firmware">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Firmware has to be sent over your local network — it does not go through SmartLink. So a radio that will live somewhere you cannot reach should be brought up to date before it goes."/>
                            <TextBlock x:Name="SetupFirmwareStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Firmware status"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="SetupGetFirmwareButton"
                                        Content="_Download firmware for this radio"
                                        Margin="0,0,8,0" Padding="12,4"
                                        AutomationProperties.Name="Look for firmware for this radio on the JJ Flexible servers and download it"
                                        AutomationProperties.AcceleratorKey="Alt+D"
                                        Click="SetupGetFirmwareButton_Click"/>
                                <Button x:Name="SetupChooseFirmwareButton"
                                        Content="C_hoose a file instead..."
                                        Margin="0,0,8,0" Padding="12,4"
                                        AutomationProperties.Name="Choose a firmware file already on this computer"
                                        AutomationProperties.AcceleratorKey="Alt+H"
                                        Click="SetupChooseFirmwareButton_Click"/>
                                <Button x:Name="SetupSendFirmwareButton"
                                        Content="Send to radio"
                                        IsEnabled="False" Padding="12,4"
                                        AutomationProperties.Name="Send the chosen firmware file to the radio"
                                        Click="SetupSendFirmwareButton_Click"/>
                            </StackPanel>
                            <!-- Real WPF ProgressBar rather than spoken percentages.
                                 NVDA announces progress bars using the user's own
                                 setting - beep, speak, both, or off - so the app
                                 deciding when to talk overrides a preference the
                                 user already expressed, and interrupts other speech
                                 to do it. The byte-count line below is a plain
                                 TextBlock, deliberately NOT a live region: it is
                                 there to be read on demand, not announced. -->
                            <ProgressBar x:Name="SetupFirmwareProgress"
                                         Height="18" Minimum="0" Maximum="100"
                                         Margin="0,0,0,4"
                                         Visibility="Collapsed"
                                         AutomationProperties.Name="Firmware download progress"/>
                            <TextBlock x:Name="SetupFirmwareProgressText"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       Visibility="Collapsed"
                                       AutomationProperties.Name="Firmware download bytes transferred"/>
                            <TextBlock x:Name="SetupFirmwareFileText"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Chosen firmware file"/>
                            <Button x:Name="SetupSuppressVersionWarningButton"
                                    Content="Stop reporting the version mismatch"
                                    HorizontalAlignment="Left" Padding="12,4"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="Stop reporting the firmware version mismatch. Does not change the radio."
                                    Click="SetupSuppressVersionWarningButton_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 4 -->
                    <GroupBox Header="Step 4 — Give the radio a fixed address" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 4, give the radio a fixed address">
                        <StackPanel Margin="4">
                            <TextBlock x:Name="SetupAddressStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Address status"/>
                            <controls:StaticIpControl x:Name="SetupStaticIpControl"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 4 -->
                    <GroupBox Header="Step 5 — Open a way in from the internet" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 5, open a way in from the internet">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="To reach the radio from away from home, SmartLink needs a way through the router. A forwarded port is the most reliable and needs one change on the router. UPnP does the same thing automatically when the router allows it. Where the router cannot be changed at all, hole-punch can often get through on its own."/>
                            <TextBlock x:Name="SetupWayInStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Internet access status"/>
                            <Button x:Name="SetupGoToNetworkButton"
                                    Content="Open Net_work settings"
                                    HorizontalAlignment="Left" Padding="12,4"
                                    AutomationProperties.Name="Go to the Network tab to set the port, connection mode and hole-punch port"
                                    AutomationProperties.AcceleratorKey="Alt+W"
                                    Click="SetupGoToNetworkButton_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 5 -->
                    <GroupBox Header="Step 6 — Check it from outside" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 6, check the radio can be reached from outside">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Asks SmartLink to look at your network from the outside and report what it can reach. Run this before you leave, while you can still change things."/>
                            <TextBlock x:Name="SetupCheckStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Outside check status"/>
                            <Button x:Name="SetupTestNetworkButton"
                                    Content="Run the network _test"
                                    HorizontalAlignment="Left" Padding="12,4"
                                    AutomationProperties.Name="Run the SmartLink network diagnostic"
                                    AutomationProperties.AcceleratorKey="Alt+T"
                                    Click="SetupTestNetworkButton_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Step 6 -->
                    <GroupBox Header="Step 7 — Restart the radio" Margin="0,0,0,12"
                              AutomationProperties.Name="Step 7, restart the radio">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="A fixed address only takes effect after the radio restarts. Restarting is also the first thing to try when a radio you cannot reach has stopped answering."/>
                            <TextBlock x:Name="SetupRestartStatus"
                                       Style="{StaticResource DialogLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Restart status"/>
                            <Button x:Name="SetupRebootButton"
                                    Content="R_estart the radio"
                                    HorizontalAlignment="Left" Padding="12,4"
                                    AutomationProperties.Name="Restart the radio. Asks for confirmation first."
                                    AutomationProperties.AcceleratorKey="Alt+E"
                                    Click="SetupRebootButton_Click"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Verbosity & Notifications Tab -->
            <TabItem Header="Notifications" AutomationProperties.Name="Verbosity and notifications settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <!-- Speech section -->
                    <TextBlock Text="Speech" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Speech verbosity:"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SpeechVerbosityCombo" Width="120"
                                  Style="{StaticResource DialogComboBox}"
                                  AutomationProperties.Name="Speech verbosity level"/>
                    </StackPanel>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Earcons section -->
                    <TextBlock Text="Alert Sounds" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="EarconsEnabledCheck"
                              Content="Enable alert sounds (earcons)"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable alert sounds such as beeps and tones"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- CW Notifications section -->
                    <TextBlock Text="CW Morse Notifications" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="CwNotificationsCheck"
                              Content="Enable CW notifications (AS, BT, SK prosigns)"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable Morse code notifications for connection events"/>
                    <Grid Margin="20,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Sidetone frequency (Hz):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="CwSidetoneBox" Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="CW sidetone frequency, 400 to 1200 hertz"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Speed (WPM):"
                                   Style="{StaticResource DialogLabel}" Margin="0,4,8,4"/>
                        <TextBox x:Name="CwSpeedBox" Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource DialogTextBox}"
                                 AutomationProperties.Name="CW notification speed, 10 to 30 words per minute"/>
                    </Grid>
                    <CheckBox x:Name="CwModeAnnounceCheck"
                              Content="Announce mode changes in CW (when speech is off)"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Play mode name in Morse code when speech verbosity is off"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Meter Tones enable (moved from Audio) -->
                    <TextBlock Text="Meter Tones" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="MeterTonesNotifCheck"
                              Content="Enable meter tones"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Enable meter tones"/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Display elements -->
                    <TextBlock Text="Display" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ShowPanadapterCheck"
                              Content="Show panadapter / waterfall display"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Show the panadapter and waterfall display. When unchecked, the display is hidden from view and removed from the tab order and braille refreshes are suppressed."/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Tune feedback -->
                    <TextBlock Text="Tune Feedback" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="AnnounceSwrAfterTuneCheck"
                              Content="Read final SWR reading after manual or automatic tune"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Read final SWR reading after manual or automatic tune."/>

                    <Separator Margin="0,4,0,8"/>

                    <!-- Connection progress -->
                    <TextBlock Text="Connection Progress" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="SpeakConnectionProgressCheck"
                              Content="Speak connection progress while connecting to a radio"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Speak connection progress. When checked, JJ Flex announces each connection phase and plays a counting tone (1, 2, then 3 tones) as the connect proceeds. Critical messages (errors, cancel, timeout) always speak regardless of this setting."/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Sprint 28 Phase 1 — Accessibility Tab. Home for input-timing and
                 other accessibility-tuning preferences. Starts with DoubleTapTolerance;
                 future phases may add hold-to-repeat delay, announcement timing, etc. -->
            <TabItem Header="Accessibility" AutomationProperties.Name="Accessibility timing and input preferences">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <!-- Input Timing section -->
                    <TextBlock Text="Input Timing" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Double-tap tolerance controls how quickly you need to press a key twice for JJ Flex to recognize the second press as part of a double-tap. This affects filter-edge bracket double-tap (entering single-edge adjust mode) and Escape-Escape to collapse all field groups. Pick a setting that matches your typing cadence — faster if you tap quickly, slower if you verify speech between presses."/>

                    <GroupBox Header="Double-tap tolerance" Margin="0,0,0,8"
                              AutomationProperties.Name="Double-tap tolerance">
                        <StackPanel Margin="4">
                            <RadioButton x:Name="DoubleTapQuickRadio"
                                         GroupName="DoubleTapTolerance"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Quick, 250 milliseconds, for fast typists"
                                         Checked="DoubleTapToleranceRadio_Checked">
                                <TextBlock Text="Quick (250 ms)"/>
                            </RadioButton>
                            <RadioButton x:Name="DoubleTapNormalRadio"
                                         GroupName="DoubleTapTolerance"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Normal, 500 milliseconds, recommended default"
                                         Checked="DoubleTapToleranceRadio_Checked">
                                <TextBlock Text="Normal (500 ms, recommended)"/>
                            </RadioButton>
                            <RadioButton x:Name="DoubleTapRelaxedRadio"
                                         GroupName="DoubleTapTolerance"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Relaxed, 750 milliseconds, for deliberate input"
                                         Checked="DoubleTapToleranceRadio_Checked">
                                <TextBlock Text="Relaxed (750 ms)"/>
                            </RadioButton>
                            <RadioButton x:Name="DoubleTapLeisurelyRadio"
                                         GroupName="DoubleTapTolerance"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Leisurely, 1000 milliseconds, for verifying speech between presses"
                                         Checked="DoubleTapToleranceRadio_Checked">
                                <TextBlock Text="Leisurely (1000 ms)"/>
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Sprint 29 Track D — Updates tab. Channel selector, auto-check
                 toggles, manual "Check now," last-check timestamp. The
                 first-time-nightly consent dialog fires when the user picks
                 Nightly without having acknowledged it before. -->
            <TabItem Header="Updates" AutomationProperties.Name="Update channel and auto-check preferences">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="Update channel" FontWeight="SemiBold"
                               Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Stable is the public release channel. Beta gets milestone previews. Nightly tracks the very latest overnight build — useful for testers and for picking up fixes the same day, but it can be unstable."/>

                    <GroupBox Header="Channel" Margin="0,0,0,8"
                              AutomationProperties.Name="Update channel selector">
                        <StackPanel Margin="4">
                            <RadioButton x:Name="UpdateChannelStableRadio"
                                         GroupName="UpdateChannel"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Stable, public releases"
                                         Checked="UpdateChannelRadio_Checked">
                                <TextBlock Text="Stable (public releases)"/>
                            </RadioButton>
                            <RadioButton x:Name="UpdateChannelBetaRadio"
                                         GroupName="UpdateChannel"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Beta, milestone previews"
                                         Checked="UpdateChannelRadio_Checked">
                                <TextBlock Text="Beta (milestone previews)"/>
                            </RadioButton>
                            <RadioButton x:Name="UpdateChannelNightlyRadio"
                                         GroupName="UpdateChannel"
                                         Margin="0,4,0,4"
                                         AutomationProperties.Name="Nightly, overnight builds, may be unstable"
                                         Checked="UpdateChannelRadio_Checked">
                                <TextBlock Text="Nightly (overnight builds, may be unstable)"/>
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="UpdateAutoCheckCheckbox"
                              Content="Check for updates when JJ Flex starts"
                              Margin="0,0,0,4"
                              AutomationProperties.Name="Check for updates when JJ Flex starts"/>
                    <CheckBox x:Name="UpdatePeriodicCheckCheckbox"
                              Content="Check every two hours while JJ Flex is running"
                              Margin="0,0,0,12"
                              AutomationProperties.Name="Check every two hours while JJ Flex is running"/>

                    <TextBlock x:Name="UpdateLastCheckText"
                               Text="Last check: never"
                               Margin="0,0,0,8"
                               AutomationProperties.Name="Last update check timestamp"/>

                    <Button x:Name="UpdateCheckNowButton"
                            Content="Check for updates now"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            AutomationProperties.Name="Check for updates now"
                            Click="UpdateCheckNowButton_Click"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</local:JJFlexDialog>
