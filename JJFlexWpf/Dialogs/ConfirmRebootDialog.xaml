<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.ConfirmRebootDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JJFlexWpf"
                    Title="Confirm Radio Reboot"
                    Width="460"
                    SizeToContent="Height"
                    WindowStartupLocation="CenterScreen"
                    ShowInTaskbar="False"
                    ResizeMode="NoResize"
                    AutomationProperties.Name="Confirm radio reboot">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageBlock"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   AutomationProperties.Name="Radio reboot confirmation"/>
        <TextBlock x:Name="OtherStationsBlock"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="Collapsed"
                   AutomationProperties.Name="Other stations affected"/>
        <TextBlock TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="The radio will be unreachable for several minutes while it restarts. Continue?"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="NoButton"
                    Content="_No"
                    Width="80" Margin="0,0,8,0"
                    IsCancel="True"
                    AutomationProperties.Name="No, do not reboot the radio"
                    Click="NoButton_Click"/>
            <Button x:Name="YesButton"
                    Content="_Yes"
                    Width="80"
                    IsDefault="False"
                    AutomationProperties.Name="Yes, reboot the radio"
                    Click="YesButton_Click"/>
        </StackPanel>
    </StackPanel>
</local:JJFlexDialog>
