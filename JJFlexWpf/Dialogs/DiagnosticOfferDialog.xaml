<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.DiagnosticOfferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:JJFlexWpf"
    Title="Something went wrong. Save the diagnostic log?"
    Width="520" SizeToContent="Height"
    ResizeMode="NoResize">
    <!-- The Title is written by the caller and carries the whole context on
         purpose. A screen reader flushes its speech queue when a window opens,
         so anything spoken just before this appears is destroyed — the arriving
         window has to announce itself. Same lesson as PendingDisconnectLead. -->
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ButtonPanel}">
            <Button x:Name="SaveButton" Content="Save the diagnostic log..."
                    Style="{StaticResource OkButton}"
                    AutomationProperties.Name="Save the diagnostic log"
                    Click="SaveButton_Click"/>
            <Button x:Name="CopyPathButton" Content="Copy the log file path"
                    Style="{StaticResource DialogButton}"
                    AutomationProperties.Name="Copy the log file path"
                    Click="CopyPathButton_Click"/>
            <!-- IsCancel so Escape and the button do the same thing. This
                 dialog appears unbidden, so it has to be trivially dismissible. -->
            <Button x:Name="NotNowButton" Content="Not now"
                    Style="{StaticResource CancelButton}"
                    IsCancel="True"
                    AutomationProperties.Name="Not now"
                    Click="NotNowButton_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,0,0,10"
                       AutomationProperties.Name="What happened"/>
            <TextBlock x:Name="OfferText" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="The diagnostic log recorded what the app was doing. You can save a copy now, while it is still fresh, or find it later in Settings, Diagnostics."/>
            <TextBlock TextWrapping="Wrap"
                       AutomationProperties.Name="Privacy"
                       Text="Nothing is sent anywhere. Saving puts a copy wherever you choose."/>
        </StackPanel>
    </DockPanel>
</local:JJFlexDialog>
