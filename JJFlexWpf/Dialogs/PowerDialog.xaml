<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.PowerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        xmlns:controls="clr-namespace:JJFlexWpf.Controls"
        Title="Power"
        Width="420" SizeToContent="Height">
    <StackPanel Margin="12" KeyboardNavigation.TabNavigation="Cycle">
        <!-- Unit/context line: which scale this dialog is currently in.
             It used to be a tab stop so an exploring operator could land on it,
             which cost a stop on every pass through a three-control dialog to
             reach a sentence nobody needs twice (#211). It is registered
             against the two power fields instead, so Ctrl+F1 on either reads
             the scale and the range together with what the field does. -->
        <TextBlock x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <controls:ValueFieldControl x:Name="RfPowerField" Margin="0,2" />
        <controls:ValueFieldControl x:Name="TunePowerField" Margin="0,2" />

        <!-- Range and entry help. Same treatment, same reason. -->
        <TextBlock x:Name="RangeText" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Close" Padding="12,4"
                    AutomationProperties.Name="Close power dialog"
                    AutomationProperties.AcceleratorKey="Alt+C"
                    IsCancel="True"
                    Click="CloseButton_Click" />
        </StackPanel>
    </StackPanel>
</local:JJFlexDialog>
