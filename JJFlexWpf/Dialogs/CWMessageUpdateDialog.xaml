<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.CWMessageUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        Title="Messages"
        Width="420" Height="340"
        SizeToContent="Height">
    <StackPanel Margin="12">
        <Label Content="Messages" Padding="0,0,0,4" />
        <!-- The list's explanation is set from the lexicon in the constructor
             (#717), as JJFlexHelp.Text so it is read on Ctrl+F1 and never on
             focus: settings.cw_message.list_help, which names Tab and Escape. -->
        <ListBox x:Name="KeysList" Height="160"
                 AutomationProperties.Name="Messages"
                 SelectionChanged="KeysList_SelectionChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="AddButton" Content="_Add" MinWidth="70" Height="28"
                    Margin="0,0,8,0" Click="AddButton_Click"
                    AutomationProperties.Name="Add"
                    AutomationProperties.AcceleratorKey="Alt+A" />
            <Button x:Name="UpdateButton" Content="_Update" MinWidth="70" Height="28"
                    Margin="0,0,8,0" Click="UpdateButton_Click"
                    AutomationProperties.Name="Update"
                    AutomationProperties.AcceleratorKey="Alt+U" />
            <Button x:Name="DeleteButton" Content="_Delete" MinWidth="70" Height="28"
                    Margin="0,0,8,0" Click="DeleteButton_Click"
                    AutomationProperties.Name="Delete"
                    AutomationProperties.AcceleratorKey="Alt+D" />
            <!-- Close, not Cancel and not OK (#717): every add, update and
                 delete is already saved when its own step returns, so there is
                 nothing to cancel and nothing left to confirm. IsCancel keeps
                 Escape closing it. -->
            <Button x:Name="CloseButton" Content="_Close" AutomationProperties.AcceleratorKey="Alt+C" MinWidth="70" Height="28"
                    IsCancel="True"
                    AutomationProperties.Name="Close" />
        </StackPanel>
    </StackPanel>
</local:JJFlexDialog>
