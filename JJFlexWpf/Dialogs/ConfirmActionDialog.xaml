<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.ConfirmActionDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JJFlexWpf"
                    Title="Confirm"
                    Width="470"
                    SizeToContent="Height"
                    WindowStartupLocation="CenterScreen"
                    ShowInTaskbar="False"
                    ResizeMode="NoResize">
    <StackPanel Margin="16">
        <!-- The whole body — message, warnings, question — is one read-only
             text box so it can be read line by line with the arrow keys and
             re-read at the user's own pace. The warnings are the
             highest-stakes text in flows like registration and firmware
             (key-the-mic guidance, do-not-power-off); TextBlocks and
             ItemsControls are invisible to the caret, which is how they went
             unread during a real firmware update (live find, 2026-08-04).
             Focus lands here on open. Enter does nothing in a read-only box
             and Yes is not the default button, so reading first stays the
             path of least resistance. -->
        <TextBox x:Name="BodyText"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 MaxHeight="380"
                 Margin="0,0,0,12"
                 AutomationProperties.Name="What is about to happen, and its warnings"/>

        <!-- "Don't show this again" (Track C): only present when the caller
             passes a suppression key. Suppresses the TEACHING, never a
             receipt — callers that use this must still show their outcome
             some other re-readable way. Sits above the buttons, after the
             body in tab order. -->
        <CheckBox x:Name="DontShowAgainCheck"
                  Content="_Don't show this explanation again"
                  Margin="0,0,0,4"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Don't show this explanation again"/>

        <!-- The jacks button sits on the left, deliberately away from No and Yes:
             it is a detour, not an answer, and it should not sit between the two
             buttons that commit or cancel. It appears only when we have a verified
             panel reference for the connected radio. -->
        <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="JacksButton"
                    DockPanel.Dock="Left"
                    Content="Where are the _jacks on my radio?"
                    Padding="10,0" Height="26"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Where are the jacks on my radio?"
                    AutomationProperties.AcceleratorKey="Alt+J"
                    Click="JacksButton_Click"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="NoButton"
                        Content="_No"
                        Width="80" Margin="0,0,8,0"
                        IsCancel="True"
                        AutomationProperties.Name="No, cancel"
                        Click="NoButton_Click"/>
                <Button x:Name="YesButton"
                        Content="_Yes"
                        Width="80"
                        IsDefault="False"
                        AutomationProperties.Name="Yes, continue"
                        Click="YesButton_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</local:JJFlexDialog>
