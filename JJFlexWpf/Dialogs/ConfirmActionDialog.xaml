<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.ConfirmActionDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JJFlexWpf"
                    Title="Confirm"
                    Width="470"
                    SizeToContent="Height"
                    WindowStartupLocation="CenterScreen"
                    ShowInTaskbar="False"
                    ResizeMode="NoResize"
                    AutomationProperties.Name="Confirm action">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageBlock"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   AutomationProperties.Name="What is about to happen"/>

        <!-- Warnings render as a plain vertical list of wrapped TextBlocks.
             Deliberately not a ListBox or DataGrid: a screen reader reads
             this as ordinary prose in reading order, with no grid navigation
             mode to enter and escape from. -->
        <ItemsControl x:Name="WarningsList"
                      Margin="0,0,0,12"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Warnings">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="QuestionBlock"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="Continue?"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="NoButton"
                    Content="_No"
                    Width="80" Margin="0,0,8,0"
                    IsCancel="True"
                    AutomationProperties.Name="No, cancel"
                    Click="NoButton_Click"/>
            <Button x:Name="YesButton"
                    Content="_Yes"
                    Width="80"
                    IsDefault="False"
                    AutomationProperties.Name="Yes, continue"
                    Click="YesButton_Click"/>
        </StackPanel>
    </StackPanel>
</local:JJFlexDialog>
