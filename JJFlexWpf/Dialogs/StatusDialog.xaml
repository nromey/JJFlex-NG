<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.StatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        xmlns:controls="clr-namespace:JJFlexWpf.Controls"
        Title="Radio Status"
        Width="480" Height="560"
        ResizeMode="NoResize"
        AutomationProperties.Name="Radio Status">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="StatusList" Grid.Row="0"
                 Margin="4" BorderThickness="0" Background="Transparent"
                 AutomationProperties.Name="Radio status information"
                 IsTabStop="True"
                 KeyboardNavigation.TabNavigation="Once"/>

        <!-- QB Track D: network identity card — who the radio is and how we
             reach it. Its own tab stop below the status list; arrow through
             the lines. The label is a heading for sighted layout; the card's
             list carries its own accessible name for screen readers. -->
        <TextBlock Grid.Row="1" Text="Network identity" Margin="4,8,4,0"
                   FontWeight="Bold"/>
        <controls:NetworkIdentityCard x:Name="IdentityCard" Grid.Row="2"
                 Margin="4,2,4,0" MaxHeight="150"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="_Copy to Clipboard" MinWidth="130" Height="28" Margin="0,0,8,0"
                    AutomationProperties.Name="Copy to Clipboard"
                    AutomationProperties.AcceleratorKey="Alt+C"
                    Click="CopyButton_Click"/>
            <Button Content="C_lose" MinWidth="80" Height="28"
                    IsDefault="True" IsCancel="True"
                    AutomationProperties.Name="Close"
                    AutomationProperties.AcceleratorKey="Alt+L"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</local:JJFlexDialog>
