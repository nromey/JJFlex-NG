<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.RigSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        xmlns:controls="clr-namespace:JJFlexWpf.Controls"
        Title="Select Radio"
        Width="640" Height="560"
        ResizeMode="NoResize"
        Closing="RigSelectorDialog_Closing">
    <!-- Width went 560 -> 640 on 2026-08-19: the connection-path items now
         carry their own meaning ("SmartLink first, then local network"), which
         does not fit a 130-pixel combo. The extra width goes to the right-hand
         column, so the radio list keeps the room it had. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Sighted-layout heading only. The ListBox below carries its own
             accessible name ("Available radios, N listed, N online"), so a
             plain TextBlock here was the same words twice - once as dialog
             body text on open, once when focus reached the list. -->
        <controls:DecorativeText Grid.Row="0" Grid.Column="0" Text="Available Radios:"
                   Margin="0,0,0,4"/>

        <!-- Radio list.
             DirectionalNavigation="Contained" keeps arrow keys inside the list
             at BOTH ends. Arrowing off the top used to land silently on the
             auto-connect checkbox — a keyboard user looking for the first radio
             instead found themselves on a setting they never meant to touch.
             Tab remains the way out; Shift+Tab comes back to the selected row. -->
        <ListBox x:Name="RadiosBox" Grid.Row="1" Grid.Column="0"
                 Margin="0,0,8,0"
                 Focusable="True"
                 IsTabStop="True"
                 KeyboardNavigation.TabNavigation="Once"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 AutomationProperties.Name="Radio list"
                 GotFocus="RadiosBox_GotFocus"
                 LostFocus="RadiosBox_LostFocus"
                 ContextMenuOpening="RadiosBox_ContextMenuOpening"
                 SelectionChanged="RadiosBox_SelectionChanged">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Connect" Click="ConnectMenuItem_Click"
                              AutomationProperties.Name="Connect to selected radio using its preferred path"/>
                    <!-- The explicit verbs. Connect over SmartLink is the
                         force-remote rescue path and the hole-punch test
                         instrument: this path only, never a silent fallback
                         to local. -->
                    <MenuItem x:Name="ConnectLocalMenuItem" Header="Connect Locally"
                              Click="ConnectLocalMenuItem_Click"
                              AutomationProperties.Name="Connect to selected radio over the local network only"/>
                    <MenuItem x:Name="ConnectRemoteMenuItem" Header="Connect over SmartLink"
                              Click="ConnectRemoteMenuItem_Click"
                              AutomationProperties.Name="Connect to selected radio over SmartLink only, never falling back to local"/>
                    <!-- Which path Connect tries first, saved with the radio.
                         Items built per open; same store as the Connection
                         path combo - no sync problem. -->
                    <MenuItem x:Name="DefaultPathMenuItem" Header="Default Connection Path"
                              AutomationProperties.Name="Default connection path for selected radio"/>
                    <!-- Task #102, door one of two: the per-radio reset. The
                         other is the Network tab in Settings, which does it for
                         every radio at once. Sits next to the path items
                         because it undoes what they describe — the "learned"
                         wording on the Automatic item is exactly what this
                         takes back. Enabled only when there is something to
                         forget, so it never promises an action it cannot
                         perform. -->
                    <MenuItem x:Name="ForgetLearnedPathMenuItem"
                              Header="Forget the Learned Connection Path"
                              Click="ForgetLearnedPathMenuItem_Click"
                              AutomationProperties.Name="Forget the learned connection path for selected radio"/>
                    <Separator/>
                    <MenuItem x:Name="FavoriteMenuItem" Header="Add to Favorites"
                              Click="FavoriteMenuItem_Click"
                              AutomationProperties.Name="Add selected radio to favorites"/>
                    <MenuItem x:Name="AutoConnectMenuItem" Header="Auto-Connect Settings..."
                              Click="AutoConnectMenuItem_Click"
                              AutomationProperties.Name="Auto-connect settings for selected radio"/>
                    <!-- Phase 2: per-radio account binding, door one of two.
                         Items are built per open (saved accounts change while
                         the selector is up). Same store as the Account
                         Manager's associations view - no sync problem. -->
                    <MenuItem x:Name="PreferredAccountMenuItem" Header="Preferred Account"
                              AutomationProperties.Name="Preferred account for selected radio"/>
                    <Separator/>
                    <!-- List-scoped, needs no selection: the old Remote
                         button's list job lives here now that Connect opens
                         SmartLink by itself whenever a radio's chain asks. -->
                    <MenuItem x:Name="RemoteListMenuItem" Header="Show Remote Radios"
                              Click="RemoteListMenuItem_Click"
                              AutomationProperties.Name="Show this account's SmartLink radios"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
            <Button x:Name="ConnectButton" Content="Co_nnect" MinWidth="130" Height="28" Margin="0,0,0,8"
                    AutomationProperties.Name="Connect"
                    AutomationProperties.AcceleratorKey="Alt+N"
                    Click="ConnectButton_Click"/>
            <CheckBox x:Name="LowBWCheckBox" Content="_Low BW" MinWidth="130" Height="28" Margin="0,0,0,8"
                      VerticalContentAlignment="Center"
                      IsEnabled="False"
                      AutomationProperties.Name="Low bandwidth for selected radio"
                      AutomationProperties.AcceleratorKey="Alt+L"
                      Checked="LowBWCheckBox_Changed"
                      Unchecked="LowBWCheckBox_Changed"/>
            <!-- Connection path: the ORDER a connect walks for the selected
                 radio, persisted with that radio.

                 The comment here used to say this was enabled only for a radio
                 answering on BOTH paths. That stopped being true when the
                 preference moved from a session bool to a stored chain: it is
                 enabled for every KNOWN radio, offline ones included, because
                 the preference matters most for exactly the radios the app
                 believes have only one home. SyncPathAffordance is the code
                 that says so. Corrected 2026-08-19 — description drift.

                 Task #107: each item's own text carries its whole meaning, so
                 the screen reader's reading of the item IS the answer and no
                 second utterance follows an arrow press. The long-form
                 explanation is on JJFlexHelp.Text, reachable with Ctrl+F1 and
                 silent otherwise — never HelpText, which NVDA reads aloud as
                 the control's description on every single focus. That text is
                 SET IN CODE (SyncPathAffordance), not here, because its last
                 sentence reports whether path learning is currently switched
                 on; two copies of it would be two copies to drift. -->
            <Label x:Name="PathLabel" Content="Connection _path" Padding="0,0,0,2"
                   Target="{Binding ElementName=PathCombo}"/>
            <ComboBox x:Name="PathCombo" MinWidth="230" Height="24" Margin="0,0,0,8"
                      IsEnabled="False"
                      AutomationProperties.Name="Connection path"
                      AutomationProperties.AcceleratorKey="Alt+P"
                      SelectionChanged="PathCombo_SelectionChanged"/>
            <!-- The Remote button is gone (2026-08-15 decision): Connect
                 honours each radio's stored path preference and opens
                 SmartLink itself when the chain asks for it. Force-remote
                 and the remote-list refresh live in the row context menu. -->
            <Button x:Name="AccountButton" Content="_Switch Account" MinWidth="130" Height="28" Margin="0,0,0,8"
                    AutomationProperties.Name="Switch Account"
                    AutomationProperties.AcceleratorKey="Alt+S"
                    Click="SwitchAccountButton_Click"/>
            <Button x:Name="TestButton" Content="_Test" MinWidth="130" Height="28" Margin="0,0,0,8"
                    AutomationProperties.Name="Test"
                    AutomationProperties.AcceleratorKey="Alt+T"
                    Click="TestButton_Click"/>
            <Button x:Name="AutoConnectButton" Content="_Auto-Connect" MinWidth="130" Height="28" Margin="0,0,0,8"
                    AutomationProperties.Name="Auto-Connect"
                    AutomationProperties.AcceleratorKey="Alt+A"
                    IsEnabled="False"
                    Click="AutoConnectButton_Click"/>
            <Button Content="_Cancel" AutomationProperties.AcceleratorKey="Alt+C" MinWidth="130" Height="28" IsCancel="True"
                    AutomationProperties.Name="Cancel"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Global auto-connect checkbox -->
        <CheckBox x:Name="GlobalAutoConnectCheckbox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="Enable auto-connect on startup" Margin="0,8,0,0"
                  AutomationProperties.Name="Enable auto-connect on startup"
                  Checked="GlobalAutoConnectCheckbox_Changed"
                  Unchecked="GlobalAutoConnectCheckbox_Changed"/>

        <!-- Which SmartLink account is in play. Read-only but a real tab stop:
             a TextBlock is invisible to anyone driving the dialog by keyboard,
             and "which account am I about to use?" is exactly the question the
             Remote button used to answer only by surprise. -->
        <TextBox x:Name="AccountStatusText" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                 Margin="0,8,0,0"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 BorderThickness="0" Background="Transparent"
                 TextWrapping="Wrap"
                 Text="SmartLink account: none saved"
                 AutomationProperties.Name="SmartLink account"/>

        <!-- The identity card, behind an Expander and collapsed by default.
             THREE problems, one control.

             It describes the radio the app is CONNECTED to - so on the startup
             path, where nothing is connected yet, it had nothing to say and
             said it anyway. A screen reader reads a dialog's static content on
             open, so it was recited before the operator had even chosen a
             radio; on 2026-08-18 that came out as "no radio connected, connect
             first" in the middle of the connect sequence.

             It also had a bold "Network identity" heading above it, which is
             the card's own accessible name repeated - the Expander header is
             now the single place those words live.

             Collapsed content is Visibility.Collapsed, so it leaves the UIA
             tree entirely: not read on open, not tabbed into, one keypress away
             the moment it is wanted. It earns its place when the picker is
             opened later from a connected state to switch rigs, which is
             exactly when an Expander shines.

             Deliberately NOT auto-expanded when a radio happens to be
             connected: a panel that appears and disappears on its own changes
             the tab order underneath a keyboard user, who then cannot predict
             whether the next Tab lands on the card or past it. -->
        <Expander x:Name="IdentityExpander" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                  Header="Network identity" Margin="0,8,0,0"
                  AutomationProperties.Name="Network identity">
            <controls:NetworkIdentityCard x:Name="IdentityCard"
                 Margin="0,2,0,0" MaxHeight="120"/>
        </Expander>
    </Grid>
</local:JJFlexDialog>
