<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.TNFDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        Title="Tracking Notch Filters"
        Width="320" SizeToContent="Height"
        ResizeMode="NoResize">

    <StackPanel Margin="12">
        <!-- The notches themselves, named by frequency. First in the tab order
             because everything below it acts on whichever one is selected, and
             an operator who lands on Width without knowing which notch they are
             widening has been told the wrong thing first. -->
        <TextBlock Text="Notches" Margin="0,0,0,4"/>
        <ListBox x:Name="TNFList" Height="100" Margin="0,0,0,8"
                 AutomationProperties.Name="Tracking notch filters, by frequency"
                 local:JJFlexHelp.Text="Select a notch by frequency. The Frequency, Width, Depth and Keep this notch settings will all apply to the selected notch."
                 SelectionChanged="TNFList_SelectionChanged"/>

        <!-- Width, depth and permanence of the selected notch. All three go
             flat when nothing is selected, which takes them out of the tab
             order too — a control that cannot act should not be somewhere to
             land. -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- #773: moving the selected notch (ruled 2026-10-19: fine and
                 coarse steps, like tuning, and a typed frequency). Up and
                 down arrows move it 100 hertz, Shift with them 10 hertz;
                 typed digits go in with Enter. It writes on Enter and on an
                 arrow only, and on leaving only when the typed text was
                 changed, so tabbing through moves nothing. The Ctrl+F1 text
                 is Noel's own, approved 2026-11-19 with batch 14's words;
                 closing the window with Escape applies a typed change too
                 (checked on the 8600). No marker in the text: a marker is
                 spoken. -->

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Frequency:" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox x:Name="FrequencyBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                     AutomationProperties.Name="Notch frequency, up and down arrows to move it"
                     local:JJFlexHelp.Text="Press the Up and Down arrow to move the selected notch by 100 hertz. Use shift with arrows to move the notch up or down by 10 hertz. To set a specific notch frequency, edit the frequency shown (enter megahertz with a decimal point, or enter kilohertz without one). Press Enter to apply the typed changes or press escape to apply your changes."
                     PreviewKeyDown="FrequencyBox_PreviewKeyDown" LostFocus="FrequencyBox_LostFocus"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Width:" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox x:Name="WidthBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                     AutomationProperties.Name="Notch width in hertz, up and down arrows to change"
                     local:JJFlexHelp.Text="How wide the notch is, from 50 to 5000 hertz, in steps of 50. Up and down arrows change it and say the new number; you can also type one and press Enter. Narrow is what you want for a single carrier — a wide notch takes a piece of the band with it."
                     PreviewKeyDown="WidthBox_PreviewKeyDown" LostFocus="WidthBox_LostFocus"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Depth:" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox x:Name="DepthBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                     AutomationProperties.Name="Notch depth, 1 to 3, up and down arrows to change"
                     local:JJFlexHelp.Text="How hard the notch bites, from 1 to 3. Deep is usually right for a steady carrier. Up and down arrows change it and say the new number."
                     PreviewKeyDown="DepthBox_PreviewKeyDown" LostFocus="DepthBox_LostFocus"/>

            <!-- A yes or no choice is a checkbox: Space toggles it and the
                 screen reader says checked or not checked. It was a two-item
                 "No"/"Yes" list. The label promises only restarts: FlexLib
                 sends "tnf set <id> permanent=" and says nothing about what
                 the radio does with it, and the one behaviour on record for
                 the flag is a notch kept through a power cycle. Nothing ties
                 it to band changes, so the old "across band changes" claim is
                 gone. DRAFT label and help text. -->
            <CheckBox x:Name="PermanentCheck" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Keep this notch when the radio restarts"
                      AutomationProperties.Name="Keep this notch when the radio restarts"
                      local:JJFlexHelp.Text="Checked, the radio stores this notch and puts it back after it is turned off and on again. Right for a birdie that lives at one frequency forever, wrong for a station that will have moved by tomorrow. Not checked, the notch goes when the radio restarts."
                      Checked="PermanentCheck_Changed" Unchecked="PermanentCheck_Changed"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal">
            <Button Content="_Add" MinWidth="60" Margin="0,0,8,0"
                    AutomationProperties.Name="Add a notch"
                    AutomationProperties.AcceleratorKey="Alt+A"
                    local:JJFlexHelp.Text="Places a notch at the frequency you are receiving on, so tune onto the tone you want gone before pressing this. The radio is what creates it, so you are told when it is there — or told if the radio would not place it."
                    Click="AddButton_Click"/>
            <Button x:Name="RemoveButton" Content="_Remove" MinWidth="60" Margin="0,0,8,0"
                    AutomationProperties.Name="Remove the selected notch"
                    AutomationProperties.AcceleratorKey="Alt+R"
                    local:JJFlexHelp.Text="Takes out the notch you are on and leaves you on the next one. A kept notch is removed from the radio too, so it will not come back after a restart."
                    Click="RemoveButton_Click"/>
            <!-- IsCancel gives Escape, which every dialog must answer. NOT
                 IsDefault: Enter is not handled in the notch list, so a default
                 button would make arrowing the list and pressing Enter close
                 the window out from under an operator who was expecting the
                 list to do something. There is nothing to commit here anyway —
                 every change has already gone to the radio. -->
            <Button Content="_Done" MinWidth="75" IsCancel="True"
                    AutomationProperties.Name="Done"
                    AutomationProperties.AcceleratorKey="Alt+D"
                    Click="DoneButton_Click"/>
        </StackPanel>
    </StackPanel>
</local:JJFlexDialog>
