<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.ShowHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        Title="Keys Listing"
        Width="400" Height="400"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="SecondaryButton" Visibility="Collapsed"
                    MinWidth="120" Height="28" Margin="0,0,8,0"
                    Click="SecondaryButton_Click" />
            <Button Content="_Close" AutomationProperties.AcceleratorKey="Alt+C" MinWidth="80" Height="28"
                    IsDefault="True" AutomationProperties.AccessKey="Alt+C" IsCancel="True"
                    AutomationProperties.Name="Close" />
        </StackPanel>
        <ListBox x:Name="HelpListBox"
                 FontFamily="Consolas"
                 AutomationProperties.Name="Key commands"
                 PreviewKeyDown="HelpListBox_PreviewKeyDown" />
    </DockPanel>
</local:JJFlexDialog>
