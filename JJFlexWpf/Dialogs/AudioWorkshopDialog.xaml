<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.AudioWorkshopDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        Title="Audio Workshop"
        Width="500" Height="620"
        ShowInTaskbar="True"
        ResizeMode="CanResize">
    <DockPanel>
        <!-- Toolbar at top -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4">
            <!-- Load/Save use the universal document keys Ctrl+O / Ctrl+S
                 (handled in OnPreviewKeyDown). Save deliberately has NO
                 access-key underscore: its old Alt+S mnemonic also matched
                 Alt+Shift+S and shadowed the global Speak Transmit Status
                 chord — in the one dialog where an operator most needs to
                 query their audio (Noel, field use 2026-08-11). WPF access
                 keys match with Shift held, so any NEW mnemonic letter here
                 must first be checked against the global Alt+Shift chords
                 (keyboard-reference.md is the roster). Import's Alt+I was
                 checked 2026-08-12: no Alt+Shift+I chord exists anywhere. -->
            <Button x:Name="LoadPresetButton" Content="_Load Preset" Margin="0,0,4,0" Padding="8,4"
                    AutomationProperties.Name="Load Preset"
                    AutomationProperties.AcceleratorKey="Ctrl+O"
                    Click="LoadPreset_Click"/>
            <Button x:Name="SavePresetButton" Content="Save Preset" Margin="0,0,4,0" Padding="8,4"
                    AutomationProperties.Name="Save Preset"
                    AutomationProperties.AcceleratorKey="Ctrl+S"
                    Click="SavePreset_Click"/>
            <Button x:Name="ExportButton" Content="_Export" Margin="0,0,4,0" Padding="8,4"
                    AutomationProperties.Name="Export"
                    AutomationProperties.AcceleratorKey="Alt+E"
                    Click="Export_Click"/>
            <Button x:Name="ImportButton" Content="_Import" Margin="0,0,4,0" Padding="8,4"
                    AutomationProperties.Name="Import"
                    AutomationProperties.AcceleratorKey="Alt+I"
                    Click="Import_Click"/>
            <Button x:Name="ResetButton" Content="_Reset" Margin="0,0,4,0" Padding="8,4"
                    AutomationProperties.Name="Reset"
                    AutomationProperties.AcceleratorKey="Alt+R"
                    Click="Reset_Click"/>
        </StackPanel>

        <TabControl x:Name="MainTabs" Margin="4"
                    KeyboardNavigation.TabNavigation="Cycle">
            <!-- Tab 1: TX Audio -->
            <TabItem Header="TX Audio" AutomationProperties.Name="TX Audio Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="TxAudioContent" Margin="8" />
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Live Meters -->
            <TabItem Header="Live Meters" AutomationProperties.Name="Live Meter Readings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="LiveMetersContent" Margin="8" />
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Earcon Explorer -->
            <TabItem Header="Earcon Explorer" AutomationProperties.Name="Earcon Sound Explorer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="EarconExplorerContent" Margin="8" />
                </ScrollViewer>
            </TabItem>

            <!-- Amplifier (Sprint 32 Track D). NAMED rather than referred to by
                 index: four tracks add tabs to this control in one sprint, and a
                 reorder must not silently point code at the wrong panel. -->
            <TabItem x:Name="AmplifierTab" Header="Amplifier"
                     AutomationProperties.Name="Amplifier and Tuner">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="AmplifierContent" Margin="8" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</local:JJFlexDialog>
