<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.AudioWorkshopDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        Title="Audio Workshop"
        Width="680" Height="620"
        ShowInTaskbar="True"
        ResizeMode="CanResize">
    <!-- Wider than it was (500) because the category list now takes the
         left-hand 170 (Sprint 32 Track G, task #134). The Workshop grows to
         five or six categories this sprint, which is the exact condition a tab
         strip handles worst. -->
    <DockPanel>
        <!-- Toolbar at top. TabIndex 1 keeps the ring reading the way the
             window looks: toolbar across the top, category list down the left,
             the category itself filling the rest. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4"
                    KeyboardNavigation.TabIndex="1">
            <!-- Load/Save use the universal document keys Ctrl+O / Ctrl+S
                 (handled in OnPreviewKeyDown). Save deliberately has NO
                 access-key underscore: its old Alt+S mnemonic also matched
                 Alt+Shift+S and shadowed the global Speak Transmit Status
                 chord — in the one dialog where an operator most needs to
                 query their audio (Noel, field use 2026-08-11). WPF access
                 keys match with Shift held, so any NEW mnemonic letter here
                 must first be checked against the global Alt+Shift chords
                 (keyboard-reference.md is the roster). Import's Alt+I was
                 checked 2026-08-12: no Alt+Shift+I chord exists anywhere. -->
            <Button x:Name="LoadPresetButton" Content="_Load Preset" Margin="0,0,4,0" Padding="8,4"
                    AutomationProperties.Name="Load Preset"
                    AutomationProperties.AcceleratorKey="Ctrl+O"
                    Click="LoadPreset_Click"/>
            <Button x:Name="SavePresetButton" Content="Save Preset" Margin="0,0,4,0" Padding="8,4"
                    AutomationProperties.Name="Save Preset"
                    AutomationProperties.AcceleratorKey="Ctrl+S"
                    Click="SavePreset_Click"/>
            <Button x:Name="ExportButton" Content="_Export" Margin="0,0,4,0" Padding="8,4"
                    AutomationProperties.Name="Export"
                    AutomationProperties.AcceleratorKey="Alt+E"
                    Click="Export_Click"/>
            <Button x:Name="ImportButton" Content="_Import" Margin="0,0,4,0" Padding="8,4"
                    AutomationProperties.Name="Import"
                    AutomationProperties.AcceleratorKey="Alt+I"
                    Click="Import_Click"/>
            <Button x:Name="ResetButton" Content="_Reset" Margin="0,0,4,0" Padding="8,4"
                    AutomationProperties.Name="Reset"
                    AutomationProperties.AcceleratorKey="Alt+R"
                    Click="Reset_Click"/>
        </StackPanel>

        <!-- The category list (task #134). Built by CategoryNavigator from
             whatever TabItems exist below, never listed here — three other
             tracks were adding categories to this window while this was
             written, and not one of them had to touch this file. -->
        <ListBox x:Name="CategoryListBox"
                 DockPanel.Dock="Left"
                 Style="{StaticResource CategoryList}"
                 Margin="8,4,4,4"
                 TabIndex="2"
                 AutomationProperties.Name="Workshop categories"
                 local:JJFlexHelp.Text="Every part of the Workshop, in one list. Arrow through it to move between them, or use Control plus Tab and Control plus Shift plus Tab from anywhere in this window. Inside a category, F6 and Shift plus F6 move between its sections."/>

        <!-- Styled headerless: the list to the left IS the tab strip now.
             TabNavigation was "Cycle" here from March 2026 until Sprint 32
             Track G. That trapped Tab inside the categories: an operator
             working in the content could tab forever and never reach Load
             Preset, Save Preset, Export, Import or Reset. It was a reasonable
             fix at the time — the window is non-modal and its tab order was
             genuinely broken — but JJFlexDialog gave every dialog a
             window-level Cycle on 2026-08-10, which does the wrapping properly
             and one level further out. Leaving it here after that turned a fix
             into a cage. The default (Continue) is what lets Tab out. -->
        <local:CategoryTabHost x:Name="MainTabs" Margin="4"
                    Style="{StaticResource CategoryTabControl}"
                    KeyboardNavigation.TabIndex="3"
                    AutomationProperties.Name="Workshop categories">
            <!-- ONE category called "TX Audio" until 2026-08-25, holding TEN
                 sections. That is three different subjects under one name, and
                 it made the category the operator complained about (Noel: "the
                 tab with audio check is where the biggest issue is").

                 Ten sections is ten F6 presses to cross, and the name at the
                 top tells you nothing about which third you are standing in.
                 Split into three categories of three or four, the category
                 list — which is now what you land on — does the work it was
                 built for, and no category is deeper than four.

                 Every tab here is NAMED. The meter merge earlier the same day
                 removed a category and two poll guards were comparing
                 SelectedIndex against 0 and 1; an index comparison does not
                 fail loudly when the order changes, it silently starts
                 refreshing the wrong panel. -->

            <!-- Everything this COMPUTER does to your voice, before the radio
                 hears any of it: which microphone, what that microphone needs,
                 and what gets cleaned out of the room. -->
            <TabItem x:Name="ThisComputerTab" Header="This Computer"
                     AutomationProperties.Name="This Computer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="ThisComputerContent" Margin="8" />
                </ScrollViewer>
            </TabItem>

            <!-- Everything the RADIO does to it after that: which input it
                 listens to, how it shapes and band-limits your voice, and how
                 you hear yourself. -->
            <TabItem x:Name="TransmitSettingsTab" Header="Transmit Settings"
                     AutomationProperties.Name="Transmit Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="TransmitSettingsContent" Margin="8" />
                </ScrollViewer>
            </TabItem>

            <!-- Putting a signal through all of it and listening to the
                 result: a known tone, a known recording, or your own voice
                 played back to you. These are how you TUNE the two categories
                 above — the Fixer is where you go when something is broken. -->
            <TabItem x:Name="HearYourselfTab" Header="Hear Yourself"
                     AutomationProperties.Name="Hear Yourself">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="HearYourselfContent" Margin="8" />
                </ScrollViewer>
            </TabItem>

            <!-- Meters. Two categories until 2026-08-25 — "Live Meters" (eight
                 hand-picked readings) and "Meter Inventory" (all hundred-odd the
                 radio publishes). From the operator's chair that was one subject
                 split across two places in the category list, with no way to
                 tell from the names which one held the reading you wanted
                 (Noel: "not sure why we have a meter readings tab and a meter
                 inventory tab").

                 They are one category now, and the inventory is a BUTTON inside
                 it rather than a peer of it — which is also the honest shape:
                 the eight readings are what an operator wants ninety-nine times
                 out of a hundred, and the full list is a deliberate act. -->
            <TabItem x:Name="MetersTab" Header="Meters"
                     AutomationProperties.Name="Meters">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="8">
                        <StackPanel x:Name="LiveMetersContent" />
                        <StackPanel x:Name="MeterInventoryContent" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Earcon Explorer -->
            <TabItem Header="Earcon Explorer" AutomationProperties.Name="Earcon Sound Explorer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="EarconExplorerContent" Margin="8" />
                </ScrollViewer>
            </TabItem>

            <!-- Amplifier (Sprint 32 Track D). NAMED rather than referred to by
                 index: four tracks add tabs to this control in one sprint, and a
                 reorder must not silently point code at the wrong panel. -->
            <TabItem x:Name="AmplifierTab" Header="Amplifier"
                     AutomationProperties.Name="Amplifier and Tuner">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="AmplifierContent" Margin="8" />
                </ScrollViewer>
            </TabItem>

            <!-- Diagnostics (Sprint 32 Track C). Named rather than reached by
                 index: several tracks append here, and anything that compared
                 an index would break silently the moment the order changed. -->
            <TabItem x:Name="DiagnosticsTab" Header="Diagnostics"
                     AutomationProperties.Name="Audio Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="DiagnosticsContent" Margin="8" />
                </ScrollViewer>
            </TabItem>
        </local:CategoryTabHost>
    </DockPanel>
</local:JJFlexDialog>
