<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.TuningStepsDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JJFlexWpf"
                    xmlns:controls="clr-namespace:JJFlexWpf.Controls"
                    Title="Tuning Steps"
                    Width="380"
                    SizeToContent="Height"
                    ShowInTaskbar="False"
                    ResizeMode="NoResize">
    <!-- The picker half of #302. The arrow ladder (Alt+Left/Right for coarse,
         Shift+Left/Right for fine) walks one rung at a time without leaving
         the frequency field; this sets BOTH values outright, and shows what
         the choices actually are — which a ladder cannot do.

         Two lists, not two combo boxes, and that is the whole design decision
         here: there are five options each, every one fits on screen, and a
         list answers "what can I have?" by being arrowed through, with no
         expand step in the way. A combo box makes the same five options
         something you have to open first.

         The options come from Radios.TuningSteps, the same table the ladder
         keys walk and the same one the Settings dialog now shows. One list,
         three surfaces — before #302 the Settings dialog held its own private
         arrays, and the first key that walked past their ends would have made
         Settings silently reset the operator's step on OK. -->
    <StackPanel Margin="16">
        <controls:DecorativeText Text="Coarse step — Up and Down tune by this:"
                                 Style="{StaticResource DialogLabel}"
                                 Margin="0,0,0,4"/>
        <ListBox x:Name="CoarseList"
                 Height="120"
                 Margin="0,0,0,8"
                 AutomationProperties.Name="Coarse tuning step"
                 local:JJFlexHelp.Text="The step Up and Down move the frequency by. From the frequency field you can also walk this list with Alt and the left and right arrows, without opening this window."/>

        <!-- #346 part two: edit the coarse list here, the list S opens (ruled
             J3). Labels set from the lexicon in code (DRAFT, for Codex). -->
        <controls:DecorativeText x:Name="CoarseNewLabel"
                                 Style="{StaticResource DialogLabel}"
                                 Margin="0,0,0,2"/>
        <TextBox x:Name="CoarseNewBox" Margin="0,0,0,4"/>
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="CoarseAddButton" MinWidth="90" Height="28" Margin="0,0,8,0" Click="CoarseAddButton_Click"/>
            <Button x:Name="CoarseRemoveButton" MinWidth="90" Height="28" Margin="0,0,8,0" Click="CoarseRemoveButton_Click"/>
            <Button x:Name="CoarseStartingButton" MinWidth="90" Height="28" Click="CoarseStartingButton_Click"/>
        </WrapPanel>

        <controls:DecorativeText Text="Fine step — Shift plus Up and Down tune by this:"
                                 Style="{StaticResource DialogLabel}"
                                 Margin="0,0,0,4"/>
        <ListBox x:Name="FineList"
                 Height="120"
                 Margin="0,0,0,8"
                 AutomationProperties.Name="Fine tuning step"
                 local:JJFlexHelp.Text="The step Shift plus Up and Down move the frequency by. From the frequency field you can also walk this list with Shift and the left and right arrows, without opening this window."/>

        <!-- #346 part two: edit the fine list here, the list S opens (ruled
             J3). Labels set from the lexicon in code (DRAFT, for Codex). -->
        <controls:DecorativeText x:Name="FineNewLabel"
                                 Style="{StaticResource DialogLabel}"
                                 Margin="0,0,0,2"/>
        <TextBox x:Name="FineNewBox" Margin="0,0,0,4"/>
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="FineAddButton" MinWidth="90" Height="28" Margin="0,0,8,0" Click="FineAddButton_Click"/>
            <Button x:Name="FineRemoveButton" MinWidth="90" Height="28" Margin="0,0,8,0" Click="FineRemoveButton_Click"/>
            <Button x:Name="FineStartingButton" MinWidth="90" Height="28" Click="FineStartingButton_Click"/>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton"
                    Content="_OK"
                    MinWidth="90" Height="28" Margin="0,0,8,0"
                    IsDefault="True"
                    AutomationProperties.Name="OK"
                    AutomationProperties.AcceleratorKey="Alt+O"
                    Click="OkButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="_Cancel"
                    MinWidth="90" Height="28"
                    IsCancel="True"
                    AutomationProperties.Name="Cancel"
                    AutomationProperties.AcceleratorKey="Alt+C"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</local:JJFlexDialog>
