<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.AudioDevicesDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JJFlexWpf"
                    Title="Audio Devices"
                    Width="580" Height="700"
                    ResizeMode="NoResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ButtonPanel}">
            <Button x:Name="RefreshButton"
                    Content="_Refresh device list"
                    MinWidth="150" Height="28" Margin="0,0,8,0"
                    AutomationProperties.Name="Refresh the device list"
                    AutomationProperties.AcceleratorKey="Alt+R"
                    local:JJFlexHelp.Text="Asks Windows for its sound devices again, for when something was plugged in or switched on after this window opened. The page's overall status follows."
                    Click="RefreshButton_Click"/>
            <Button x:Name="OkButton"
                    Content="_OK"
                    Style="{StaticResource OkButton}"
                    AutomationProperties.Name="OK, save these audio devices"
                    AutomationProperties.AcceleratorKey="Alt+O"
                    Click="OkButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="_Cancel"
                    Style="{StaticResource CancelButton}"
                    AutomationProperties.Name="Cancel"
                    AutomationProperties.AcceleratorKey="Alt+C"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Overall state. Read-only, but it is the first thing on the
                     page so an operator arrowing down hears the situation before
                     the controls. -->
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource DialogLabel}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Audio device status"/>

                <!-- ================= Radio audio (PortAudio) ================= -->
                <TextBlock Text="Radio audio through this computer"
                           FontWeight="SemiBold"
                           Style="{StaticResource DialogLabel}"
                           Margin="0,0,0,2"/>

                <!-- ===== Three levels, not one filter (#207, Sprint 37 H) =====
                     Hardware, then endpoint, then transport — because that is
                     what audio actually is. The flat lists put all three in
                     one long row list plus one filter, which is why 26 rows
                     described four devices. Each combo below is short and its
                     meaning obvious: "Audient EVO8", then "Main Output 1/2",
                     then WASAPI. The audio-system selector moved BELOW the
                     devices because it no longer decides what the device
                     combos contain — devices are named by hardware, and the
                     audio system says how the chosen ones are reached.

                     "Follow the Windows default" is the first row of each
                     device combo and a real, persisted choice — not a label on
                     a row. It survives renames, hot-plugs and driver updates,
                     because it names no hardware to go stale.

                     The advanced toggle at the bottom swaps these combos for
                     the flat every-endpoint lists, which is also where the
                     microphone and receive audio can be put on different
                     audio systems. -->
                <Label x:Name="RadioOutputDeviceLabel"
                       Content="Radio receive audio _plays through:"
                       Target="{Binding ElementName=RadioOutputDeviceCombo}"
                       Style="{StaticResource DialogFieldLabel}"
                       Margin="0,0,0,2"/>
                <ComboBox x:Name="RadioOutputDeviceCombo"
                          Style="{StaticResource DialogComboBox}"
                          Margin="0,0,0,4"
                          AutomationProperties.Name="Radio receive audio device"
                          local:JJFlexHelp.Text="The device your radio's receive audio plays through. Pick hardware by name, or choose Follow the Windows default and JJ Flexible always uses whatever Windows is playing through. On a remote connection this is the only way to hear the radio at all."
                          SelectionChanged="RadioOutputDeviceCombo_SelectionChanged"/>
                <Label x:Name="RadioOutputEndpointLabel"
                       Content="Output on that de_vice:"
                       Target="{Binding ElementName=RadioOutputEndpointCombo}"
                       Style="{StaticResource DialogFieldLabel}"
                       Margin="0,0,0,2"/>
                <ComboBox x:Name="RadioOutputEndpointCombo"
                          Style="{StaticResource DialogComboBox}"
                          Margin="0,0,0,4"
                          AutomationProperties.Name="Output on that device"
                          local:JJFlexHelp.Text="Which output on the chosen device carries the radio. Choosable only when the device has more than one."
                          SelectionChanged="RadioOutputEndpointCombo_SelectionChanged"/>

                <!-- Advanced view of the same choice: every endpoint of every
                     audio system, flat, each row naming its own. -->
                <Label x:Name="RadioOutputListLabel"
                       Content="Every receive audio endpoint:"
                       Target="{Binding ElementName=RadioOutputList}"
                       Style="{StaticResource DialogFieldLabel}"
                       Margin="0,0,0,2"
                       Visibility="Collapsed"/>
                <ListBox x:Name="RadioOutputList"
                         Height="110"
                         Margin="0,0,0,4"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         Visibility="Collapsed"
                         AutomationProperties.Name="Radio receive audio output device"
                         local:JJFlexHelp.Text="How the radio reaches your ears. On a remote connection it is the only way to hear it at all. Every endpoint of every audio system is listed, and each row names its own."/>
                <TextBlock x:Name="RadioOutputNote"
                           Style="{StaticResource DialogLabel}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Radio receive audio device note"/>

                <Label x:Name="RadioInputDeviceLabel"
                       Content="M_icrophone sent to the radio:"
                       Target="{Binding ElementName=RadioInputDeviceCombo}"
                       Style="{StaticResource DialogFieldLabel}"
                       Margin="0,0,0,2"/>
                <ComboBox x:Name="RadioInputDeviceCombo"
                          Style="{StaticResource DialogComboBox}"
                          Margin="0,0,0,4"
                          AutomationProperties.Name="Microphone device sent to the radio"
                          local:JJFlexHelp.Text="The device the radio hears you through. Pick hardware by name, or choose Follow the Windows default and JJ Flexible always uses whatever Windows is recording from. On a remote connection this is the only way the radio can hear you."
                          SelectionChanged="RadioInputDeviceCombo_SelectionChanged"/>
                <Label x:Name="RadioInputEndpointLabel"
                       Content="Input on that d_evice:"
                       Target="{Binding ElementName=RadioInputEndpointCombo}"
                       Style="{StaticResource DialogFieldLabel}"
                       Margin="0,0,0,2"/>
                <ComboBox x:Name="RadioInputEndpointCombo"
                          Style="{StaticResource DialogComboBox}"
                          Margin="0,0,0,4"
                          AutomationProperties.Name="Input on that device"
                          local:JJFlexHelp.Text="Which input on the chosen device the radio listens to. Choosable only when the device has more than one."
                          SelectionChanged="RadioInputEndpointCombo_SelectionChanged"/>

                <Label x:Name="RadioInputListLabel"
                       Content="Every microphone endpoint:"
                       Target="{Binding ElementName=RadioInputList}"
                       Style="{StaticResource DialogFieldLabel}"
                       Margin="0,0,0,2"
                       Visibility="Collapsed"/>
                <ListBox x:Name="RadioInputList"
                         Height="110"
                         Margin="0,0,0,4"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         Visibility="Collapsed"
                         AutomationProperties.Name="Microphone input device sent to the radio"
                         local:JJFlexHelp.Text="How the radio hears you. On a remote connection it is the only way it can. Every endpoint of every audio system is listed, and each row names its own."
                         SelectionChanged="RadioInputList_SelectionChanged"/>
                <TextBlock x:Name="RadioInputNote"
                           Style="{StaticResource DialogLabel}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Microphone device note"/>

                <!-- ===== Audio system — the TRANSPORT level =====
                     Below the devices since Sprint 37 (#207), because it now
                     SELECTS rather than filters: it decides how the chosen
                     devices above are reached, and changing it moves them —
                     out loud, on OK — rather than changing what the combos
                     contain. One selector governs both directions, the DAW
                     convention; the advanced toggle is where they can be set
                     apart. -->
                <Label Content="_Audio system the devices are reached through:"
                       Target="{Binding ElementName=HostApiCombo}"
                       Style="{StaticResource DialogFieldLabel}"
                       Margin="0,0,0,2"/>
                <ComboBox x:Name="HostApiCombo"
                          Style="{StaticResource DialogComboBox}"
                          Margin="0,0,0,4"
                          AutomationProperties.Name="Audio system the devices are reached through"
                          local:JJFlexHelp.Text="The Windows driver model JJ Flexible reaches your chosen devices through. It applies to both the microphone and the receive audio; your device choices above stay the same when you change it."
                          SelectionChanged="HostApiCombo_SelectionChanged"/>
                <TextBlock x:Name="HostApiNote"
                           Style="{StaticResource DialogLabel}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           AutomationProperties.Name="Audio system note"/>

                <!-- ===== Transmit quality (Track E, 2026-08-16) =====
                     Which device, at what rate, is one decision, so the rate
                     sits with the devices rather than off in Settings. A
                     request rather than a command: the device settles the rate
                     before the encoder is built, so the note under it says
                     what actually happened last time. -->
                <Label Content="Transmit audio _quality:"
                       Target="{Binding ElementName=TxRateCombo}"
                       Style="{StaticResource DialogFieldLabel}"
                       Margin="0,0,0,2"/>
                <ComboBox x:Name="TxRateCombo"
                          Style="{StaticResource DialogComboBox}"
                          Margin="0,0,0,4"
                          AutomationProperties.Name="Transmit audio quality"
                          local:JJFlexHelp.Text="The sample rate JJ Flexible encodes your microphone at before sending it to the radio. Full quality is the tested setting; the lower ones use less of your connection when the link is poor."
                          SelectionChanged="TxRateCombo_SelectionChanged"/>
                <TextBlock x:Name="TxRateNote"
                           Style="{StaticResource DialogLabel}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           AutomationProperties.Name="Transmit audio quality note"/>

                <!-- ================= Microphone Check ================= -->
                <!-- Answers "is this microphone working" without a transmitter.
                     Sits directly under the microphone list because it checks
                     whatever is selected there. -->
                <TextBlock Text="Microphone check"
                           FontWeight="SemiBold"
                           Style="{StaticResource DialogLabel}"
                           Margin="0,0,0,2"/>

                <Button x:Name="MicCheckButton"
                        Content="Start _microphone check"
                        MinWidth="200" Height="28"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,4"
                        AutomationProperties.Name="Start microphone check"
                        AutomationProperties.AcceleratorKey="Alt+M"
                        local:JJFlexHelp.Text="Listens to the microphone selected above and reads its level back as you speak. No radio is involved and nothing is transmitted. Press it again to stop."
                        Click="MicCheckButton_Click"/>

                <!-- The verdict lives in a read-only EDIT, not a label: an edit
                     is focusable and review-readable where a label gets skipped,
                     and because the value sits somewhere focusable the screen
                     reader's own read-current-control command IS the "say my
                     level" feature. Same idiom as the Audio Workshop's mic
                     reading; the accessible name is set once at build time so
                     the twice-a-second refresh never interrupts. -->
                <TextBox x:Name="MicCheckReading"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         Margin="0,0,0,4"
                         AutomationProperties.Name="Microphone check reading"/>

                <!-- ===== Windows input level (Mic Level Track, 2026-08-13) =====
                     Stage one of the capture chain: the level Windows records
                     the microphone at, before any radio is involved. It sits
                     right beside the reading it moves, so "coming in hot" is a
                     verdict with its remedy next to it instead of a dead end.
                     The slider is DISABLED, with the note saying why, whenever
                     the selected PortAudio device cannot be confidently matched
                     to a Windows endpoint — silently moving some other
                     microphone's level is worse than offering nothing, and a
                     disabled control stays out of the tab order. -->
                <TextBlock Text="Windows input level:"
                           Style="{StaticResource DialogLabel}"
                           Margin="0,4,0,2"/>
                <Slider x:Name="MicLevelSlider"
                        Minimum="0" Maximum="100"
                        SmallChange="1" LargeChange="5"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        IsEnabled="False"
                        Margin="0,0,0,4"
                        AutomationProperties.Name="Windows input level"
                        local:JJFlexHelp.Text="Stage one of your capture chain: the level Windows records this microphone at, before any radio is involved. If the mic check says Hot, bring this down; if it says Quiet, bring it up."
                        ValueChanged="MicLevelSlider_ValueChanged"/>

                <!-- Shown only when the driver actually has a boost part. A
                     boost left up is the classic cause of a pinned 0 dBFS
                     reading, the modern Settings app does not show it at all,
                     and an operator who cannot see mmsys.cpl's Levels tab had
                     no way to reach it until now. -->
                <TextBlock x:Name="MicBoostLabel"
                           Text="Microphone Boost:"
                           Style="{StaticResource DialogLabel}"
                           Margin="0,0,0,2"
                           Visibility="Collapsed"/>
                <Slider x:Name="MicBoostSlider"
                        IsSnapToTickEnabled="True"
                        Margin="0,0,0,4"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Microphone Boost"
                        local:JJFlexHelp.Text="The driver's extra lift for this microphone, hidden by the modern Windows Settings app. A boost left high is the classic cause of a pinned, clipping reading — try zero if the check says Hot with the level already low."
                        ValueChanged="MicBoostSlider_ValueChanged"/>

                <!-- Same idiom as the privacy button below: the way out of a
                     block appears only while the block exists. A Windows mute
                     wins over every slider on this page, so while it is on,
                     this button is the only control here that matters. -->
                <Button x:Name="MicUnmuteButton"
                        Content="_Unmute this microphone in Windows"
                        MinWidth="200" Height="28"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,4"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Unmute this microphone in Windows"
                        AutomationProperties.AcceleratorKey="Alt+U"
                        Click="MicUnmuteButton_Click"/>

                <TextBlock x:Name="MicLevelNote"
                           Style="{StaticResource DialogLabel}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"
                           AutomationProperties.Name="Windows input level note"/>

                <Button x:Name="MicPrivacyButton"
                        Content="Open _Windows microphone privacy settings"
                        MinWidth="200" Height="28"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,10"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Open Windows microphone privacy settings"
                        AutomationProperties.AcceleratorKey="Alt+W"
                        Click="MicPrivacyButton_Click"/>

                <Separator Margin="0,4,0,8"/>

                <!-- ================= Alerts / CW (NAudio) ================= -->
                <TextBlock Text="Alerts, CW notifications, and meter tones"
                           FontWeight="SemiBold"
                           Style="{StaticResource DialogLabel}"
                           Margin="0,0,0,2"/>

                <Label Content="Alert and CW notification _device:"
                       Target="{Binding ElementName=AlertDeviceCombo}"
                       Style="{StaticResource DialogFieldLabel}"
                       Margin="0,0,0,2"/>
                <ComboBox x:Name="AlertDeviceCombo"
                          Style="{StaticResource DialogComboBox}"
                          Margin="0,0,0,8"
                          AutomationProperties.Name="Alert and CW notification output device"
                          local:JJFlexHelp.Text="These are JJ Flex's own sounds, not the radio's. CW notifications play through this device; there is no separate CW output to choose."/>

                <Label Content="Meter _tone device:"
                       Target="{Binding ElementName=MeterDeviceCombo}"
                       Style="{StaticResource DialogFieldLabel}"
                       Margin="0,0,0,2"/>
                <ComboBox x:Name="MeterDeviceCombo"
                          Style="{StaticResource DialogComboBox}"
                          Margin="0,0,0,8"
                          AutomationProperties.Name="Meter tone output device"
                          local:JJFlexHelp.Text="Where the meter sonification tones play. It can be the same device as alerts, or a different one to keep the tones out of your radio-audio ear."/>

                <Separator Margin="0,4,0,8"/>

                <!-- The device combos above group endpoints by hardware and
                     collapse the audio-system dimension. This swaps them for
                     flat lists holding every endpoint Windows offers, across
                     every audio system at once, including the kernel pins
                     that were hidden on 2026-08-11 after two operators picked
                     one and transmitted into a dead jack. It is also the way
                     to put the microphone on one audio system and the receive
                     audio on another, which the single selector above
                     deliberately does not offer. -->
                <CheckBox x:Name="AdvancedDevicesCheck"
                          Content="_Show every sound endpoint, every audio system at once (advanced)"
                          Margin="0,0,0,6"
                          AutomationProperties.Name="Show every sound endpoint, every audio system at once, advanced"
                          local:JJFlexHelp.Text="Swaps the device combos for flat lists: every endpoint Windows offers, across every audio system at once, with the system named on each row, kernel streaming included. Choosing a row chooses its audio system with it, so this is also the way to put the microphone on one audio system and the receive audio on another."
                          AutomationProperties.AcceleratorKey="Alt+S"
                          Checked="AdvancedDevicesCheck_Changed"
                          Unchecked="AdvancedDevicesCheck_Changed"/>

                <TextBlock x:Name="FilterNoteText"
                           Style="{StaticResource DialogLabel}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           AutomationProperties.Name="Device listing note"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</local:JJFlexDialog>
