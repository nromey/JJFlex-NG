<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.GpsStatusDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JJFlexWpf"
                    xmlns:controls="clr-namespace:JJFlexWpf.Controls"
                    Title="GPS and Reference"
                    Width="520" Height="560"
                    WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ButtonPanel}"
                    KeyboardNavigation.TabIndex="3">
            <Button Content="_Speak status"
                    AutomationProperties.Name="Speak the GPS summary"
                    AutomationProperties.AcceleratorKey="Alt+S"
                    Click="SpeakStatusButton_Click"/>
            <Button Content="_Copy details"
                    AutomationProperties.Name="Copy all GPS details to the clipboard"
                    AutomationProperties.AcceleratorKey="Alt+C"
                    Click="CopyDetailsButton_Click"/>
            <Button Content="C_lose"
                    IsCancel="True"
                    AutomationProperties.Name="Close"
                    Click="CloseButton_Click"/>
        </StackPanel>

        <!-- Reference selection sits between the status text and the buttons:
             read first, then act. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    Margin="0,8,0,8" KeyboardNavigation.TabIndex="2">
            <TextBlock Text="Reference oscillator:" VerticalAlignment="Center"
                       Style="{StaticResource DialogLabel}" Margin="0,0,8,0"/>
            <ComboBox x:Name="OscillatorCombo" Width="330"
                      Style="{StaticResource DialogComboBox}"
                      AutomationProperties.Name="Reference oscillator selection"
                      SelectionChanged="OscillatorCombo_SelectionChanged"/>
        </StackPanel>

        <!-- The ONLY live region in this dialog. It receives text solely
             on a transition worth interrupting for — the reference
             handing over, or the GPS phase changing, or a satellite
             count that has actually settled. Everything else on this
             page refreshes silently for the review caret, because it
             changes once a second and a live region on it would never
             stop talking. -->
        <TextBlock x:Name="StateAnnounceText"
                   DockPanel.Dock="Top"
                   Style="{StaticResource DialogLabel}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="GPS state change"/>

        <!-- One arrowable surface for everything: summary, hardware,
             oscillator state, per-field details, and the explanatory prose.
             Focus lands here on open; the caret survives the 1 Hz refresh
             (LiveStatusTextBox preserves the reading position and skips
             rewrites when nothing changed). -->
        <controls:LiveStatusTextBox x:Name="StatusText"
                                    KeyboardNavigation.TabIndex="1"
                                    AutomationProperties.Name="GPS status details"/>
    </DockPanel>
</local:JJFlexDialog>
