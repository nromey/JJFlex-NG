<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.AutoConnectSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        Title="Auto-Connect Settings"
        Width="350" Height="200"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Radio name -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Radio:" Style="{StaticResource DialogLabel}"/>
            <TextBlock x:Name="RadioNameText" FontWeight="Bold"
                       AutomationProperties.Name="Radio name"/>
        </StackPanel>

        <!-- Checkboxes -->
        <CheckBox x:Name="AutoConnectCheckbox" Grid.Row="1"
                  Content="Enable auto-connect for this radio"
                  Margin="0,0,0,8"
                  AutomationProperties.Name="Enable auto-connect for this radio"/>

        <CheckBox x:Name="LowBandwidthCheckbox" Grid.Row="2"
                  Content="Use low bandwidth mode"
                  Margin="0,0,0,8"
                  AutomationProperties.Name="Use low bandwidth mode"/>

        <!-- Buttons. House convention (Track C): OK applies and closes, Apply
             applies and stays, Cancel discards — the same pair as every other
             settings screen, replacing the bespoke "Save". -->
        <StackPanel Grid.Row="4" Style="{StaticResource ButtonPanel}">
            <Button Content="_OK" AutomationProperties.AcceleratorKey="Alt+O" Style="{StaticResource OkButton}"
                    AutomationProperties.Name="OK"
                    local:JJFlexHelp.Text="Applies the auto-connect settings and closes this dialog."
                    Click="OkButton_Click"/>
            <Button Content="_Apply" AutomationProperties.AcceleratorKey="Alt+A" Style="{StaticResource DialogButton}"
                    AutomationProperties.Name="Apply"
                    local:JJFlexHelp.Text="Applies the auto-connect settings and leaves this dialog open."
                    Click="ApplyButton_Click"/>
            <Button Content="_Cancel" AutomationProperties.AcceleratorKey="Alt+C" Style="{StaticResource CancelButton}"
                    AutomationProperties.Name="Cancel"
                    local:JJFlexHelp.Text="Closes this dialog and discards any changes you have not applied."
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</local:JJFlexDialog>
