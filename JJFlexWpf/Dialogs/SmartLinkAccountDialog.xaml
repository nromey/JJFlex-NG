<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.SmartLinkAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        Title="Select SmartLink Account"
        Width="420" Height="440"
        SizeToContent="Manual"
        AutomationProperties.Name="Select SmartLink Account">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Instruction -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Select a saved account or log in with a new one:"
                   Margin="0,0,0,8"
                   AutomationProperties.Name="Select a saved SmartLink account or log in with a new one"/>

        <!-- Account list -->
        <ListBox x:Name="AccountListBox" Grid.Row="1" Grid.Column="0"
                 Margin="0,0,8,0"
                 AutomationProperties.Name="Saved SmartLink accounts"
                 SelectionChanged="AccountListBox_SelectionChanged"
                 MouseDoubleClick="AccountListBox_DoubleClick"
                 KeyDown="AccountListBox_KeyDown"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
            <Button x:Name="ConnectButton" Content="_Set Default" MinWidth="90" Height="28" Margin="0,0,0,8"
                    IsEnabled="False"
                    AutomationProperties.Name="Set Default"
                    AutomationProperties.AcceleratorKey="Alt+S"
                    Click="ConnectButton_Click"/>
            <Button x:Name="UseNowButton" Content="_Use Now" MinWidth="90" Height="28" Margin="0,0,0,8"
                    IsEnabled="False"
                    AutomationProperties.Name="Use now. Uses this account for the rest of this session without changing your default account."
                    AutomationProperties.AcceleratorKey="Alt+U"
                    Click="UseNowButton_Click"/>
            <Button Content="New _Login" MinWidth="90" Height="28" Margin="0,0,0,8"
                    AutomationProperties.Name="New Login"
                    AutomationProperties.AcceleratorKey="Alt+L"
                    Click="NewLoginButton_Click"/>
            <Button x:Name="RenameButton" Content="_Rename" MinWidth="90" Height="28" Margin="0,0,0,8"
                    IsEnabled="False"
                    AutomationProperties.Name="Rename"
                    AutomationProperties.AcceleratorKey="Alt+R"
                    Click="RenameButton_Click"/>
            <Button x:Name="ResetSignInButton" Content="Reset Sign-_In" MinWidth="90" Height="28" Margin="0,0,0,8"
                    IsEnabled="False"
                    AutomationProperties.Name="Reset sign-in. Clears the saved login data for this account; the account and its settings stay."
                    AutomationProperties.AcceleratorKey="Alt+I"
                    Click="ResetSignInButton_Click"/>
            <Button x:Name="DeleteButton" Content="_Delete" MinWidth="90" Height="28" Margin="0,0,0,8"
                    IsEnabled="False"
                    AutomationProperties.Name="Delete"
                    AutomationProperties.AcceleratorKey="Alt+D"
                    Click="DeleteButton_Click"/>
            <Button Content="_Cancel" AutomationProperties.AcceleratorKey="Alt+C" MinWidth="90" Height="28" IsCancel="True"
                    Margin="0,20,0,0"
                    AutomationProperties.Name="Cancel"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Per-account remote-first startup toggle; reflects the SELECTED account -->
        <CheckBox x:Name="AutoStartRemoteCheck" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="Start Remote _automatically at startup" Margin="0,8,0,0"
                  IsEnabled="False"
                  AutomationProperties.Name="Start Remote automatically at startup. When checked and this account is the one in use, the radio selector begins looking for your remote radios as soon as it opens."
                  AutomationProperties.AcceleratorKey="Alt+A"
                  Checked="AutoStartRemoteCheck_Changed"
                  Unchecked="AutoStartRemoteCheck_Changed"/>
    </Grid>
</local:JJFlexDialog>
