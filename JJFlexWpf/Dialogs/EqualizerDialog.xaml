<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.EqualizerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        Title="Equalizer"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize">

    <StackPanel Margin="12">

        <!-- One line explaining that adjustments can be tried before Finished (#609).
             A line in the window, not a second spoken sentence racing the
             title the base class speaks on arrival. Plain text on purpose:
             DecorativeText is what a screen reader is told to skip. Its words
             come from the lexicon (audio.eq.changes_live), set in code. -->
        <TextBlock x:Name="ChangesLiveNote" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- Whether the equalizer is switched on at all. First in the tab
             order on purpose: bands set on a switched-off equalizer change
             nothing the operator can hear, and finding that out last is the
             worst version of it. -->
        <CheckBox x:Name="EnabledCheck" Margin="0,0,0,10"
                  Checked="EnabledCheck_Changed" Unchecked="EnabledCheck_Changed"/>

        <!-- The nine bands, built in code-behind from FlexBase.EqBandHz so the
             count and the frequencies cannot drift from the radio's. Vertical,
             lowest at the top: the reading order IS the frequency order. -->
        <StackPanel x:Name="BandsPanel" Margin="0,0,0,12"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal">
            <Button Content="_Restore" MinWidth="75" Margin="0,0,8,0"
                    AutomationProperties.Name="Restore"
                    AutomationProperties.AcceleratorKey="Alt+R"
                    Click="RestoreButton_Click"/>
            <Button Content="Cl_ear" MinWidth="75" Margin="0,0,8,0"
                    AutomationProperties.Name="Clear"
                    AutomationProperties.AcceleratorKey="Alt+E"
                    Click="ClearButton_Click"/>
            <Button Content="_Finished" MinWidth="75" Margin="0,0,8,0" IsDefault="True" AutomationProperties.AccessKey="Alt+F"
                    AutomationProperties.Name="Finished"
                    AutomationProperties.AcceleratorKey="Alt+F"
                    Click="FinishedButton_Click"/>
            <Button Content="_Cancel" AutomationProperties.AcceleratorKey="Alt+C" MinWidth="75" IsCancel="True"
                    AutomationProperties.Name="Cancel changes"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</local:JJFlexDialog>
