<local:JJFlexDialog x:Class="JJFlexWpf.Dialogs.CWMessageAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JJFlexWpf"
        Title="Add a Message"
        Width="540" Height="260"
        SizeToContent="Height">
    <StackPanel Margin="12">
        <DockPanel Margin="0,0,0,8">
            <Label Content="Label:" DockPanel.Dock="Left" Width="90"
                   VerticalAlignment="Center" />
            <TextBox x:Name="LabelTextBox"
                     AutomationProperties.Name="Message label"
                     VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <Label Content="Key:" DockPanel.Dock="Left" Width="90"
                   VerticalAlignment="Center" />
            <TextBox x:Name="KeyTextBox" IsReadOnly="True"
                     AutomationProperties.Name="Key that sends it"
                     AutomationProperties.HelpText="Press the key that will send this message. Delete clears it."
                     PreviewKeyDown="KeyTextBox_PreviewKeyDown"
                     VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <Label Content="CW text:" DockPanel.Dock="Left" Width="90"
                   VerticalAlignment="Center" />
            <TextBox x:Name="MessageTextBox"
                     AutomationProperties.Name="CW text"
                     AutomationProperties.HelpText="Sent through the keyer when the radio is in CW. Leave it empty for a voice-only message."
                     VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <Label Content="Recording:" DockPanel.Dock="Left" Width="90"
                   VerticalAlignment="Center" />
            <Button x:Name="ListenButton" Content="_Listen" DockPanel.Dock="Right"
                    MinWidth="110" Height="28" Margin="8,0,0,0"
                    Click="ListenButton_Click"
                    AutomationProperties.Name="Listen"
                    AutomationProperties.AcceleratorKey="Alt+L"
                    AutomationProperties.HelpText="Play the selected recording through your computer so you can check it is the right one." />
            <ComboBox x:Name="RecordingCombo"
                      AutomationProperties.Name="Recording"
                      AutomationProperties.HelpText="Sent in place of your microphone when the radio is in a voice mode. Leave it on No recording for a CW-only message."
                      SelectionChanged="RecordingCombo_SelectionChanged"
                      VerticalAlignment="Center" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_OK" AutomationProperties.AcceleratorKey="Alt+O" MinWidth="80" Height="28" Margin="0,0,8,0"
                    IsDefault="True" AutomationProperties.AccessKey="Alt+O" Click="OKButton_Click"
                    AutomationProperties.Name="OK" />
            <Button Content="_Cancel" AutomationProperties.AcceleratorKey="Alt+C" MinWidth="80" Height="28"
                    IsCancel="True"
                    AutomationProperties.Name="Cancel" />
        </StackPanel>
    </StackPanel>
</local:JJFlexDialog>
