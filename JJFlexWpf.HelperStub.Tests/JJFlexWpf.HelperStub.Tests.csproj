<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for the WDSP helper, MIT, for JJ Flexible's tests only.

    It speaks Contract 2 from the JJ Flexible protocol file it links, echoes
    each channel's audio delayed by a known amount, and injects faults when
    its command line asks. It contains no WDSP, no FFTW and nothing from any
    GPL source. It is not referenced by the app and never ships: only
    JJFlexWpf.Tests builds it, and finds its exe beside the test assembly.

    The folder name contains ".Tests\" so the integration pass classifies it
    as test code.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>JJFlexWpf.HelperStub.Tests</AssemblyName>
    <RootNamespace>JJFlexWpf.HelperStub</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JJFlexWpf\WdspProtocol.cs" Link="Linked\WdspProtocol.cs" />
    <Compile Include="..\JJFlexWpf\EngineSettingDescriptor.cs" Link="Linked\EngineSettingDescriptor.cs" />
  </ItemGroup>

</Project>
