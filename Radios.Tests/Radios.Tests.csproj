<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Test-only, and it never ships: FieldKeyMapScan parses the Home field
         handlers as SYNTAX rather than as text. The handlers nest modifier
         tests inside character tests, which is exactly where a regex scan is
         least reliable and where the bugs are (#339). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Radios\Radios.csproj" />
    <ProjectReference Include="..\FlexLib_API\FlexLib\FlexLib.csproj" />
    <!-- TxFactAudit's trace parser (tools/TxFactAudit/TraceMeters.cs) had no
         committed test, and it stopped matching the txMeters line for four
         weeks without anyone knowing (#625, H17), then dropped every
         decimal-comma trace (H18). TxMetersTraceParserTests drives it
         through its public Read and Describe. A console tool with no
         dependencies beyond RigSurface, which has none. -->
    <ProjectReference Include="..\tools\TxFactAudit\TxFactAudit.csproj" />
    <!-- #520: the Flex Control knob's input filter (burst discard, F0304 kept, the press
         guard) is replayed over reconstructed event streams. JJFlexControl depends only on
         Radios and JJTrace, so no cycle and nothing new on the desk. -->
    <ProjectReference Include="..\JJFlexControl\JJFlexControl.csproj" />
    <!-- The update manifest testing lever's decision (JJFLEX_TEST_APP_MANIFEST_URL) is
         tested here, windowless. JJFlexUpdater depends only on JJTrace, so no cycle. -->
    <ProjectReference Include="..\JJFlexUpdater\JJFlexUpdater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded output transcripts used as regression fixtures. The 0822
         file is the #197 positive control: a real bench session in which a
         correct, fully-recorded Critical warning was never heard because it
         queued behind two seconds of TX narration. The queue-depth rule MUST
         flag it — a pass on that file means the instrument is broken. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A run that discovers no tests is a failure, never a pass. Without this an
       x86 run built an x64 test DLL against an x86 Radios.dll, xUnit skipped the
       whole assembly ("could not find dependent assembly") and the command exited
       0 having run nothing, so every "x86 Radios.Tests green" counted nothing.
       TreatNoTestsAsError is VSTest's own run setting (RunConfiguration); dotnet
       test hands VSTestCLIRunSettings to it as if typed after "- -". A run that
       passes its own run settings after "- -" replaces this list, so keep the
       setting in any such list. RadiosTestsRunGuardTests pins both guards. -->
  <PropertyGroup>
    <VSTestCLIRunSettings>$(VSTestCLIRunSettings);RunConfiguration.TreatNoTestsAsError=true</VSTestCLIRunSettings>
  </PropertyGroup>

  <!-- 32-bit is retired (ruled 2026-11-21), so this project is never made to build
       for x86: an x86 run is refused before anything compiles, in words that say
       which command to run instead. The zero-tests guard above is the class fix;
       this is the plain answer for the one known way to reach it. -->
  <Target Name="RefuseX86TestRun" BeforeTargets="PrepareForBuild" Condition="'$(Platform)' == 'x86'">
    <Error Text="Radios.Tests runs on x64 only. 32-bit support is retired, and an x86 run would load none of the tests and report a pass. Run: dotnet test Radios.Tests/Radios.Tests.csproj -c Debug -p:Platform=x64" />
  </Target>
</Project>
