<Project Sdk="Microsoft.NET.Sdk">
  <!-- Track D2: offline voice-render laboratory. NOT part of the app build
       or solution. Compiles the real synthesis sources from JJFlexWpf so
       what you hear from this tool is exactly what the app plays. Used to
       answer the empirical question this track exists for: are the voices
       distinguishable with several playing at once under speech?
       Run: dotnet run [-] [outputDir] [speechWavPath]  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>voicelab</AssemblyName>
    <RootNamespace>VoiceLab</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.0" />
    <!-- NAudio 3.0's metapackage puts the Windows assemblies (Wasapi, WinMM,
         Asio, Dmo, WinForms) behind a net9.0-windows10.0.19041 dependency
         group. We target net10.0-windows, which defaults to platform version
         7.0, so NuGet selects the cross-platform group and we get only Core
         and Midi. The sub-packages themselves target plain net9.0 and guard
         Windows APIs with [SupportedOSPlatform], so referencing them directly
         is correct and does NOT raise our minimum Windows version. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.0.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\JJFlexWpf\MeterVoice.cs" Link="src\MeterVoice.cs" />
    <Compile Include="..\..\JJFlexWpf\MeterModel.cs" Link="src\MeterModel.cs" />
    <Compile Include="..\..\JJFlexWpf\ContinuousToneSampleProvider.cs" Link="src\ContinuousToneSampleProvider.cs" />
    <Compile Include="..\..\JJFlexWpf\VoicedToneSampleProvider.cs" Link="src\VoicedToneSampleProvider.cs" />
  </ItemGroup>
</Project>
