<Project Sdk="Microsoft.NET.Sdk">

  <!--
    jjbrailletrial: the braille trial program (register #347, the trial Noel
    ruled on 2026-11-21). A stand-in for JJ Flexible's Home that publishes its
    braille the way the braille Home design says Home will.

    NOT in JJFlexRadio.sln and NO reference to any JJ Flexible project: the
    patterns it needs (the silent Home peer, the decorative carrier) are copied,
    not referenced, so nothing here can change the app.

    The pure view model lives in Model/ and is compiled into the test project by
    file link, so the tests never construct a window.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>jjbrailletrial</AssemblyName>
    <RootNamespace>JJBrailleTrial</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>JJBrailleTrial.Program</StartupObject>
  </PropertyGroup>

</Project>
