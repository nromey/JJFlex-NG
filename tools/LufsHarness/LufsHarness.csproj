<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LufsHarness</RootNamespace>
    <AssemblyName>LufsHarness</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The REAL meter source, linked, not copied: the harness always tests
         the code that ships. LufsMeter.cs is dependency-free (System only)
         on purpose, so this project needs no other references. -->
    <Compile Include="..\..\JJPortaudio\JJPortaudio\LufsMeter.cs" Link="LufsMeter.cs" />
    <!-- The real tone generator too, for the chained tone->meter check that
         mirrors the actual input-callback wiring. Also System-only. -->
    <Compile Include="..\..\JJPortaudio\JJPortaudio\TxToneGenerator.cs" Link="TxToneGenerator.cs" />
  </ItemGroup>
</Project>
