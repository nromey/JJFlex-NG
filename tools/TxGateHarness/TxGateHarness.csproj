<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TxGateHarness</RootNamespace>
    <AssemblyName>TxGateHarness</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The REAL gate and conditioner sources, linked, not copied: the
         harness always tests the code that ships. Both files are
         dependency-free (System only) on purpose — the same contract
         LufsMeter.cs and TxToneGenerator.cs honour for LufsHarness. -->
    <Compile Include="..\..\JJPortaudio\JJPortaudio\TxNoiseGate.cs" Link="TxNoiseGate.cs" />
    <Compile Include="..\..\JJPortaudio\JJPortaudio\TxAudioConditioner.cs" Link="TxAudioConditioner.cs" />
    <!-- Sprint 49 Track I: the stages the conditioner now owns, all System-only. -->
    <Compile Include="..\..\JJPortaudio\JJPortaudio\Biquad.cs" Link="Biquad.cs" />
    <Compile Include="..\..\JJPortaudio\JJPortaudio\ClarityExciter.cs" Link="ClarityExciter.cs" />
    <Compile Include="..\..\JJPortaudio\JJPortaudio\ParametricEq.cs" Link="ParametricEq.cs" />
    <Compile Include="..\..\JJPortaudio\JJPortaudio\DeEsser.cs" Link="DeEsser.cs" />
    <Compile Include="..\..\JJPortaudio\JJPortaudio\TxRoomFloor.cs" Link="TxRoomFloor.cs" />
    <!-- Sprint 49 Track CL: the compressor stage and the limiter, System-only too. -->
    <Compile Include="..\..\JJPortaudio\JJPortaudio\PhaseRotator.cs" Link="PhaseRotator.cs" />
    <Compile Include="..\..\JJPortaudio\JJPortaudio\TxCompressor.cs" Link="TxCompressor.cs" />
    <Compile Include="..\..\JJPortaudio\JJPortaudio\TxLimiter.cs" Link="TxLimiter.cs" />
  </ItemGroup>
</Project>
