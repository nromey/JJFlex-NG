<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>JJFlex.TxFactAudit</RootNamespace>
    <AssemblyName>TxFactAudit</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Sibling of RigSurface rather than files added INTO it. Track C owns
         that project and is still working in it; a second track editing its
         files is the merge collision the sprint rules exist to prevent. This
         consumes its public surface and adds nothing to it. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigSurface\RigSurface.csproj" />
  </ItemGroup>
</Project>
