<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.0" />
    <!-- NAudio 3.0's metapackage puts the Windows assemblies (Wasapi, WinMM,
         Asio, Dmo, WinForms) behind a net9.0-windows10.0.19041 dependency
         group. We target net10.0-windows, which defaults to platform version
         7.0, so NuGet selects the cross-platform group and we get only Core
         and Midi. The sub-packages themselves target plain net9.0 and guard
         Windows APIs with [SupportedOSPlatform], so referencing them directly
         is correct and does NOT raise our minimum Windows version. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.0.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.0.0" />
  </ItemGroup>

</Project>
