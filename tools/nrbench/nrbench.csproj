<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sprint 48 Track G (#731): the offline noise-reduction bench. NOT part of
       the app build or solution. It compiles the app's REAL noise-reduction
       sources by link, the same way tools/voicelab does, so what this tool
       renders is exactly what the app would run: the same provider, the same
       per-channel bank, the same engines, fed the same 10 ms packets.

       Runs offline only. It reads a WAV and writes WAVs and a text report. It
       opens no audio device and plays nothing; listening is done afterwards,
       in whatever the operator uses to play files.

       Run: dotnet run (project tools/nrbench) with the arguments after the
       separator. Program.cs carries the usage text. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>nrbench</AssemblyName>
    <RootNamespace>NrBench</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- deepfilter.dll is chosen by the process's bitness; pin x64 so the
         bench and the x64 DLL it loads by default agree. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FftSharp" Version="2.2.0" />
    <PackageReference Include="NAudio.Core" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\JJFlexWpf\SpectralSubtractionProvider.cs" Link="src\SpectralSubtractionProvider.cs" />
    <Compile Include="..\..\JJFlexWpf\SpectralCaptureEngine.cs" Link="src\SpectralCaptureEngine.cs" />
    <Compile Include="..\..\JJPortaudio\JJPortaudio\LufsMeter.cs" Link="src\LufsMeter.cs" />
    <Compile Include="..\..\JJFlexWpf\EngineSettingDescriptor.cs" Link="src\EngineSettingDescriptor.cs" />
    <Compile Include="..\..\Radios\DenoiseEngineSettings.cs" Link="src\DenoiseEngineSettings.cs" />
    <Compile Include="..\..\JJFlexWpf\IDenoiseEngine.cs" Link="src\IDenoiseEngine.cs" />
    <Compile Include="..\..\JJFlexWpf\RnnoiseEngine.cs" Link="src\RnnoiseEngine.cs" />
    <Compile Include="..\..\JJFlexWpf\DeepFilterNet3Engine.cs" Link="src\DeepFilterNet3Engine.cs" />
    <Compile Include="..\..\JJFlexWpf\SpecbleachEngine.cs" Link="src\SpecbleachEngine.cs" />
    <Compile Include="..\..\JJFlexWpf\CapturedNoiseWolaEngine.cs" Link="src\CapturedNoiseWolaEngine.cs" />
    <Compile Include="..\..\JJFlexWpf\PerChannelDenoiserBank.cs" Link="src\PerChannelDenoiserBank.cs" />
    <Compile Include="..\..\JJFlexWpf\NoiseReductionProvider.cs" Link="src\NoiseReductionProvider.cs" />
    <!-- Sprint 49 bench CW: the WDSP helper engines (NNR, NR2), compiled by link
         like the rest, so the bench drives the app's own host and engine over the
         pipe. The helper executable is NOT copied here: it is GPL, built in its own
         repository, and the bench is told where it is (the helper option). -->
    <Compile Include="..\..\JJFlexWpf\WdspHost.cs" Link="src\WdspHost.cs" />
    <Compile Include="..\..\JJFlexWpf\WdspHelperEngine.cs" Link="src\WdspHelperEngine.cs" />
    <Compile Include="..\..\JJFlexWpf\WdspProtocol.cs" Link="src\WdspProtocol.cs" />
    <Compile Include="..\..\JJFlexWpf\WdspNative.cs" Link="src\WdspNative.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\runtimes\win-x64\native\deepfilter.dll;..\..\runtimes\win-x64\native\deepfilter.LICENSE-*.txt;..\..\runtimes\win-x64\native\DeepFilterNet3_onnx.tar.gz">
      <Link>runtimes\win-x64\native\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="run-cpu.bat;NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\runtimes\win-x64\native\rnnoise.dll;..\..\runtimes\win-x64\native\rnnoise.COPYING.txt" Link="runtimes\win-x64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\runtimes\win-x64\native\specbleach.dll;..\..\runtimes\win-x64\native\LICENSE-libspecbleach*.txt" Link="runtimes\win-x64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\runtimes\win-x86\native\rnnoise.dll;..\..\runtimes\win-x86\native\rnnoise.COPYING.txt" Link="runtimes\win-x86\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
