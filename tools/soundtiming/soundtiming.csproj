<Project Sdk="Microsoft.NET.Sdk">
  <!-- #855: the sound timing instrument. NOT part of the app build or the
       solution, and never shipped.

       It records what actually reaches the speakers during a run (WASAPI
       loopback of the default output, every packet stamped with the audio
       engine's own clock), finds each sound in that recording with a matched
       detector built from the sound's own recipe (it renders the sound through
       the app's real code, offline, with no device), finds speech onsets,
       dropouts and clicks, and pairs every sound with the app's SoundTiming
       trace line to split its lag into generate, hand-off and buffer time.

       It never drives the app. Whoever runs it presses the keys.

       Recordings capture whatever the machine played, so they are written
       under JJFlex-private or a scratch folder, never this repository.

       Run: dotnet run -c Debug -p:Platform=x64 (project tools/soundtiming)
       with the arguments after the separator. Program.cs carries the usage. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>soundtiming</AssemblyName>
    <RootNamespace>SoundTimingTool</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\JJFlexWpf\JJFlexWpf.csproj" />
    <ProjectReference Include="..\..\Radios\Radios.csproj" />
  </ItemGroup>
</Project>
