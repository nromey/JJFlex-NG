<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64;x86;AnyCPU</Platforms>
    <PlatformTarget Condition="'$(Platform)'=='x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)'=='x86'">x86</PlatformTarget>
    <RootNamespace>Radios</RootNamespace>
    <AssemblyName>Radios</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <!-- RuntimeIdentifier removed: Radios is a class library, not an exe.
         The exe project (JJFlexRadio.vbproj) sets RuntimeIdentifier for final output.
         Having it here broke clean x86 builds (NETSDK1047 assets file mismatch). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <!-- System.Collections.Immutable and System.Security.Cryptography.ProtectedData
         are supplied by the net10.0 shared framework (NU1510); removed 2026-08-17.
         System.IO.Ports is NOT - it stays a real package reference. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- The diagnostic rules ship INSIDE the assembly so they can never go
         missing from an install and need no installer entry. An operator's own
         copy under %AppData%\JJFlexRadio replaces this one at run time; see
         ChainChecks\RuleSetLoader.cs.

         The folder is ChainChecks, not Diagnostics, and that is not cosmetic:
         a Radios.Diagnostics namespace SHADOWS System.Diagnostics for every VB
         file that imports Radios, so PersonalData.vb's Diagnostics.TraceLevel
         stopped compiling the moment it existed. Any new Radios.<X> namespace
         must be checked against System.<X> for the same reason. -->
    <EmbeddedResource Include="ChainChecks\tx-chain-rules.txt"
                      LogicalName="Radios.ChainChecks.tx-chain-rules.txt" />
  </ItemGroup>

  <!-- No screen-reader natives are copied to the app root. Speech and braille
       ship as prism.dll under runtimes\win-{x64,x86}\native\, copied by
       JJFlexRadio.vbproj alongside portaudio and libopus, and resolved by
       NativeLoader. -->

  <ItemGroup>
    <ProjectReference Include="..\escapes\escapes.csproj" />
    <ProjectReference Include="..\FlexLib_API\FlexLib\FlexLib.csproj" />
    <ProjectReference Include="..\FlexLib_API\UiWpfFramework\UiWpfFramework.csproj" />
    <ProjectReference Include="..\FlexLib_API\Util\Util.csproj" />
    <ProjectReference Include="..\FlexLib_API\Vita\Vita.csproj" />
    <ProjectReference Include="..\HamBands\HamBands.csproj" />
    <ProjectReference Include="..\JJPortaudio\JJPortaudio\JJPortaudio.csproj" />
    <ProjectReference Include="..\JJTrace\JJTrace.csproj" />
    <ProjectReference Include="..\MsgLib\MsgLib.csproj" />
    <ProjectReference Include="..\P-Opus-master\POpusCodec.csproj" />
    <ProjectReference Include="..\PortAudioSharp-src-0.19.3\PortAudioSharp\PortAudioSharp.csproj" />
  </ItemGroup>
</Project>
