<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier 1 of the Sprint 33 test suite: in-process UI Automation invariants.

    This project constructs every JJFlexWpf dialog inside the test process and
    walks its automation peer tree. It needs WPF (UseWPF), it needs STA, and it
    needs to do all of that without taking keyboard focus away from the operator
    - see README.md in this folder for both mechanisms.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>JJFlexWpf.Tests</RootNamespace>
    <AssemblyName>JJFlexWpf.Tests</AssemblyName>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Windows-only APIs are the entire point of this project. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JJFlexWpf\JJFlexWpf.csproj" />
    <ProjectReference Include="..\Radios\Radios.csproj" />
    <!-- The MIT stub that plays the WDSP helper. Built for these tests only,
         never referenced as an assembly (it links two JJFlexWpf source files,
         whose public types would collide); CopyHelperStub below puts its
         files in a HelperStub folder beside this assembly. -->
    <ProjectReference Include="..\JJFlexWpf.HelperStub.Tests\JJFlexWpf.HelperStub.Tests.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyHelperStub" AfterTargets="Build">
    <MSBuild Projects="..\JJFlexWpf.HelperStub.Tests\JJFlexWpf.HelperStub.Tests.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_HelperStubTarget" />
    </MSBuild>
    <PropertyGroup>
      <_HelperStubDir>@(_HelperStubTarget->'%(RootDir)%(Directory)')</_HelperStubDir>
    </PropertyGroup>
    <ItemGroup>
      <_HelperStubFiles Include="$(_HelperStubDir)JJFlexWpf.HelperStub.Tests.*" />
    </ItemGroup>
    <Error Condition="'@(_HelperStubFiles)' == ''" Text="The helper stub was not found in $(_HelperStubDir)." />
    <Copy SourceFiles="@(_HelperStubFiles)" DestinationFolder="$(OutDir)HelperStub" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- The measured JAWS Shift+Space streams (#800), one source file compiled
         into both test projects so the two replays cannot drift apart. -->
    <Compile Include="..\Radios.Tests\Fixtures\JawsShiftSpaceCapture20261022.cs" Link="Fixtures\JawsShiftSpaceCapture20261022.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\runtimes\win-x64\native\rnnoise.dll;..\runtimes\win-x64\native\rnnoise.COPYING.txt" Link="runtimes\win-x64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\runtimes\win-x86\native\rnnoise.dll;..\runtimes\win-x86\native\rnnoise.COPYING.txt" Link="runtimes\win-x86\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contract 2 (the WDSP helper's pipe protocol) fixtures, byte for byte
         the copy the helper's own repository holds. Copied whole; the
         manifest test refuses a drifted or partial copy. -->
    <None Update="Fixtures\Contract2\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
